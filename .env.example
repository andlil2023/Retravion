# Copy to .env to customize before first startup, or let deploy.ps1 create it.
# Unquoted values only; no variable expansion. Never commit .env.
APP_HTTPS_PORT=8443
POSTGRES_DB=retravion
POSTGRES_USER=retravion
# Blank secrets are generated once when deploy.ps1 creates .env.
# When creating .env manually, supply database/certificate secrets yourself (letters, digits, . _ -).
POSTGRES_PASSWORD=
# Required before FIRST startup: choose a username and a policy-compliant password.
# Password: 10–30 Unicode scalar values; 3 of lowercase, uppercase, digits, punctuation/symbols.
# Values are literal (no quotes, trimming, or expansion). Never use built-in defaults.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
HTTPS_CERT_PASSWORD=
