@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<MudThemeProvider Theme="PrototypeTheme.Value" IsDarkMode="_darkMode" />
<MudPopoverProvider />

<div class="app-shell @(_navigationOpen ? "navigation-open" : "") @(_darkMode ? "theme-dark" : "theme-light")">
    <a class="skip-link" href="#page-content">Skip to content</a>

    <aside id="app-navigation" class="sidebar" aria-label="Application sidebar">
        <a class="sidebar-brand" href="/home" aria-label="Retravion home">
            <MudIcon Icon="@Icons.Material.Outlined.Hub" />
            <span>Retravion</span>
        </a>
        <p class="navigation-caption">WORKSPACE</p>
        <nav aria-label="Main navigation">
            <a class="navigation-node" href="/home"><MudIcon Icon="@Icons.Material.Outlined.Home" /><span>Home</span></a>
            <AuthorizeView Policy="Administrator">
            <button type="button" class="navigation-node @(_productsSelected ? "selected" : "")"
                    aria-pressed="@_productsSelected" @onclick="SelectProducts">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" />
                <span>Products</span>
            </button>
            </AuthorizeView>
        </nav>
        <div class="sidebar-bottom">
            <AuthorizeView Policy="Administrator">
                <section aria-label="Administration">
                    <p class="navigation-caption">ADMINISTRATION</p>
                    <nav aria-label="Administration navigation">
                        <a class="navigation-node" href="/administration/users"><MudIcon Icon="@Icons.Material.Outlined.People" /><span>Users</span></a>
                    </nav>
                </section>
            </AuthorizeView>
            <div class="sidebar-footer">
                <span class="prototype-badge">UI PROTOTYPE</span>
                <form method="post" action="/identity/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text">Log out</MudButton>
                </form>
            </div>
        </div>
    </aside>

    @if (_navigationOpen)
    {
        <button type="button" class="navigation-backdrop" aria-label="Close navigation"
                @onclick="ToggleNavigation"></button>
    }

    <div class="workspace">
        <header class="page-toolbar">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" Class="navigation-toggle" Size="Size.Small"
                           OnClick="ToggleNavigation" aria-label="Toggle navigation" title="Toggle navigation"
                           aria-expanded="@_navigationOpen" aria-controls="app-navigation" />
            <div class="page-header-slot">
                @if (IsAdministration)
                {
                    <SectionOutlet SectionName="account-page-header" />
                }
                else
                {
                    <PageHeader Title="@(_productsSelected ? "Products" : "Overview")">
                        <Actions>
                            @if (_productsSelected)
                            {
                                <MudButton OnClick="ShowOverview" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ArrowBack">Overview</MudButton>
                            }
                        </Actions>
                    </PageHeader>
                }
            </div>
            <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Size="Size.Small" Class="theme-toggle" OnClick="ToggleTheme"
                           aria-label="@(_darkMode ? "Use light theme" : "Use dark theme")"
                           title="@(_darkMode ? "Use light theme" : "Use dark theme")" />
        </header>
        <main id="page-content" class="page-content" tabindex="-1" aria-label="@(IsAdministration ? "Account management content" : _productsSelected ? "Products content" : "Overview content")">
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsAdministration => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("administration/", StringComparison.OrdinalIgnoreCase);
    private bool _navigationOpen;
    private bool _productsSelected;
    private bool _darkMode;

    private void ToggleNavigation() => _navigationOpen = !_navigationOpen;
    private void ToggleTheme() => _darkMode = !_darkMode;

    private void SelectProducts()
    {
        _productsSelected = true;
        _navigationOpen = false;
    }

    private void ShowOverview() => _productsSelected = false;
}
