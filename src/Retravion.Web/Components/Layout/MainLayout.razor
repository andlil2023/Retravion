@inherits LayoutComponentBase

<MudThemeProvider Theme="PrototypeTheme.Value" IsDarkMode="_darkMode" />

<div class="app-shell @(_navigationOpen ? "navigation-open" : "") @(_darkMode ? "theme-dark" : "theme-light")">
    <a class="skip-link" href="#page-content">Skip to content</a>

    <aside id="app-navigation" class="sidebar" aria-label="Application sidebar">
        <a class="sidebar-brand" href="/home" aria-label="Retravion home">
            <MudIcon Icon="@Icons.Material.Outlined.Hub" />
            <span>Retravion</span>
        </a>
        <p class="navigation-caption">WORKSPACE</p>
        <nav aria-label="Main navigation">
            <button type="button" class="navigation-node @(_productsSelected ? "selected" : "")"
                    aria-pressed="@_productsSelected" @onclick="SelectProducts">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" />
                <span>Products</span>
            </button>
        </nav>
        <div class="sidebar-footer">
            <span class="prototype-badge">UI PROTOTYPE</span>
            <a href="/">Return to login</a>
        </div>
    </aside>

    @if (_navigationOpen)
    {
        <button type="button" class="navigation-backdrop" aria-label="Close navigation"
                @onclick="ToggleNavigation"></button>
    }

    <div class="workspace">
        <header class="page-toolbar">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" Class="navigation-toggle"
                           OnClick="ToggleNavigation" aria-label="Toggle navigation"
                           aria-expanded="@_navigationOpen" aria-controls="app-navigation" />
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Disabled="@(!_productsSelected)"
                           OnClick="ShowOverview" aria-label="Back to overview" />
            <div class="page-heading">
                <span class="eyebrow">WORKSPACE</span>
                <h1>@(_productsSelected ? "Products" : "Overview")</h1>
            </div>
            <div class="page-actions" aria-label="Page actions">
                @* Contextual Create/Edit actions belong here when a real content slice is approved. *@
                <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               OnClick="ToggleTheme" aria-label="@(_darkMode ? "Use light theme" : "Use dark theme")" />
            </div>
        </header>
        <main id="page-content" class="page-content" tabindex="-1" aria-label="@(_productsSelected ? "Products content" : "Overview content")">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _navigationOpen;
    private bool _productsSelected;
    private bool _darkMode;

    private void ToggleNavigation() => _navigationOpen = !_navigationOpen;
    private void ToggleTheme() => _darkMode = !_darkMode;

    private void SelectProducts()
    {
        _productsSelected = true;
        _navigationOpen = false;
    }

    private void ShowOverview() => _productsSelected = false;
}
