@using Microsoft.JSInterop
@using System.Text
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog open @ref="_dialog" class="description-editor-shell @(_fullscreen ? "is-fullscreen" : "") @(FieldOnly ? "field-only" : "")"
        role="@(_fullscreen ? "dialog" : "group")" aria-label="@(Label + " Markdown editor")"
        aria-modal="@(_fullscreen ? "true" : null)" @oncancel="ExitFullscreen" @oncancel:preventDefault>
@if (FieldOnly)
{
    @EditorContent
}
else
{
<MudPaper Class="product-card" Elevation="0">
    <form id="@FormId" @onsubmit="Save" @onsubmit:preventDefault aria-label="@SubmitText">
        @if (StreamedInputMaxBytes is not null)
        {
            <div inert="@(_readingForSave ? "" : null)">@ChildContent</div>
        }
        else
        {
            @ChildContent
        }
        @EditorContent
    </form>
</MudPaper>
<div class="product-actions">
    @Actions
    <MudButton ButtonType="ButtonType.Submit" form="@FormId" Variant="Variant.Filled" Color="Color.Primary"
               Disabled="@(Saving || SaveDisabled)" Class="product-button">@SubmitText</MudButton>
    @if (CancelHref is not null)
    {
        <MudButton Href="@CancelHref" Class="product-button">Cancel</MudButton>
    }
</div>
}
@if (_inputError is not null)
{
    <MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@_inputError</MudAlert>
}
@if (_fullscreenError is not null)
{
    <MudAlert Severity="Severity.Error" role="alert" Class="mt-4">@_fullscreenError</MudAlert>
}
</dialog>

@code {
    private RenderFragment EditorContent => @<div class="description-editor-content">
        <div class="description-toolbar">
            <h2>@(Optional ? $"{Label} (optional)" : Label)</h2>
            <div class="description-tools" role="group" aria-label="Editor controls">
                <div class="description-arrangement" role="group" aria-label="Editor and preview arrangement">
                    <MudIconButton Icon="@Icons.Material.Outlined.VerticalSplit" Class="product-button" Size="Size.Small"
                                   Color="@(_arrangement == "side-by-side" ? Color.Primary : Color.Default)"
                                   OnClick='@(() => _arrangement = "side-by-side")'
                                   aria-label="Side by side" title="Side by side" aria-pressed="@(_arrangement == "side-by-side")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.HorizontalSplit" Class="product-button" Size="Size.Small"
                                   Color="@(_arrangement == "stacked" ? Color.Primary : Color.Default)"
                                   OnClick='@(() => _arrangement = "stacked")'
                                   aria-label="Stacked" title="Stacked" aria-pressed="@(_arrangement == "stacked")" />
                </div>
                <MudIconButton data-markdown-fullscreen-toggle="true"
                               Icon="@(_fullscreen ? Icons.Material.Outlined.FullscreenExit : Icons.Material.Outlined.Fullscreen)"
                               Class="product-button" Size="Size.Small" aria-busy="@(_changingMode ? "true" : "false")" OnClick="ToggleFullscreen"
                               aria-label="@(_fullscreen ? "Exit fullscreen Markdown editor" : "Fullscreen Markdown editor")"
                               title="@(_fullscreen ? "Exit fullscreen (Escape)" : "Fullscreen Markdown editor")"
                               aria-expanded="@_fullscreen" />
            </div>
        </div>
        <div class="description-layout @_arrangement">
            <div class="description-source">
                <label for="@InputId">@Label (Markdown)</label>
                @if (StreamedInputMaxBytes is not null)
                {
                    @* Keep the live value in the browser; ordinary input events would send the entire value. *@
                    <textarea @ref="_source" id="@InputId" value="@InitialDescription" disabled="@(Saving || ReadOnly)" rows="@(FieldOnly ? 6 : 12)" spellcheck="true"></textarea>
                }
                else
                {
                    <textarea id="@InputId" value="@_markdown" @oninput="Edit" disabled="@(Saving || ReadOnly)" rows="@(FieldOnly ? 6 : 12)" spellcheck="true"></textarea>
                }
            </div>
            <div class="description-splitter" role="separator" tabindex="0" aria-orientation="vertical"
                 aria-label="Resize Markdown and preview panes" aria-controls="@InputId"
                 aria-valuemin="25" aria-valuemax="75" aria-valuenow="50"
                 title="Drag to resize; use Left/Right arrow keys, Home or End"></div>
            <section aria-label="@(Label + " preview")" class="description-preview">
                <h3>@(FieldOnly ? Label + " preview" : "Preview")</h3>
                <ProductMarkdownView Markdown="@_markdown" />
            </section>
        </div>

    </div>;

    [Parameter] public bool FieldOnly { get; set; }
    [Parameter] public int? StreamedInputMaxBytes { get; set; }
    [Parameter] public string InputId { get; set; } = "product-markdown";
    [Parameter, EditorRequired] public string InitialDescription { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool SaveDisabled { get; set; }
    [Parameter] public bool ExitFullscreenOnSave { get; set; }
    [Parameter] public EventCallback<string> DescriptionChanged { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string FormId { get; set; } = "product-description-form";
    [Parameter] public string SubmitText { get; set; } = "Save description";
    [Parameter] public string? CancelHref { get; set; }
    [Parameter] public bool Optional { get; set; }
    [Parameter] public string Label { get; set; } = "Description";
    private string _markdown = "";
    private string _arrangement = "side-by-side";
    private bool _initialized;
    private ElementReference _dialog, _source;
    private DotNetObjectReference<DescriptionEditor>? _inputCallback;
    private string? _inputError;
    private bool _readingForSave;
    private int _inputVersion;
    private bool Saving => Busy || _readingForSave;
    private IJSObjectReference? _module;
    private bool _fullscreen;
    private bool _changingMode;
    private bool _applyMode;
    private bool _disposed;
    private string? _fullscreenError;

    private void ToggleFullscreen()
    {
        if (_changingMode) return;
        _fullscreenError = null;
        _fullscreen = !_fullscreen;
        _changingMode = _applyMode = true;
    }

    private void ExitFullscreen()
    {
        if (_fullscreen) ToggleFullscreen();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((!firstRender && !_applyMode) || _disposed) return;
        var applyMode = _applyMode;
        _applyMode = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/markdownFullscreen.js");
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }
            if (firstRender)
            {
                await _module.InvokeVoidAsync("initializeSplitter", _dialog);
                if (!_disposed && StreamedInputMaxBytes is not null)
                {
                    _inputCallback = DotNetObjectReference.Create(this);
                    await _module.InvokeVoidAsync("initializeMarkdownInput", _dialog, _source, _inputCallback);
                }
            }
            if (applyMode) await _module.InvokeVoidAsync("setFullscreen", _dialog, _fullscreen);
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            _fullscreen = false;
            _fullscreenError = "Editor display controls could not be changed. Continue editing in the normal page.";
        }
        finally
        {
            _changingMode = false;
            if (!_disposed && (applyMode || _fullscreenError is not null)) StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("dispose", _dialog);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _inputCallback?.Dispose(); }
    }

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _markdown = InitialDescription;
        _initialized = true;
    }

    private async Task Edit(ChangeEventArgs args)
    {
        if (Busy || ReadOnly) return;
        _markdown = args.Value?.ToString() ?? "";
        await DescriptionChanged.InvokeAsync(_markdown);
    }
    [JSInvokable]
    public async Task RefreshMarkdownPreview()
    {
        if (_disposed || Saving || ReadOnly || StreamedInputMaxBytes is not int maxBytes) return;
        var version = ++_inputVersion;
        var (markdown, error) = await ReadMarkdownInput(maxBytes);
        if (_disposed || version != _inputVersion) return;
        _inputError = error;
        if (markdown is not null)
        {
            _markdown = markdown;
            await DescriptionChanged.InvokeAsync(markdown);
        }
        StateHasChanged();
    }

    private async Task<(string? Markdown, string? Error)> ReadMarkdownInput(int maxBytes)
    {
        const string readError = "The Markdown could not be read. Try again.";
        var sizeError = $"{Label} must be at most {maxBytes:N0} bytes of UTF-8 Markdown.";
        if (_module is null) return (null, readError);
        try
        {
            var input = await _module.InvokeAsync<MarkdownInput>("readMarkdownInput", _source, maxBytes);
            await using var reference = input.Content;
            if (input.InvalidUnicode) return (null, $"{Label} contains invalid Unicode. Replace the invalid characters and try again.");
            if (input.TooLarge || reference?.Length > maxBytes) return (null, sizeError);
            if (reference is null) return ("", null);
            await using var stream = await reference.OpenReadStreamAsync(maxBytes);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true), detectEncodingFromByteOrderMarks: false);
            return (await reader.ReadToEndAsync(), null);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or IOException
            or DecoderFallbackException or OperationCanceledException or TimeoutException)
        {
            return (null, readError);
        }
    }

    private sealed record MarkdownInput(bool TooLarge, bool InvalidUnicode, IJSStreamReference? Content);

    private async Task Save()
    {
        if (Saving || SaveDisabled || _changingMode) return;
        if (ExitFullscreenOnSave && _fullscreen)
        {
            _changingMode = true;
            try
            {
                if (_module is null) return;
                await _module.InvokeVoidAsync("setFullscreen", _dialog, false);
                _fullscreen = false;
                _fullscreenError = null;
            }
            catch (JSDisconnectedException) { return; }
            catch (JSException)
            {
                _fullscreenError = "Exit fullscreen before saving the status change.";
                return;
            }
            finally { _changingMode = false; }
        }
        if (StreamedInputMaxBytes is int maxBytes)
        {
            _readingForSave = true;
            ++_inputVersion; // A preview in flight must not overwrite this save's snapshot.
            try
            {
                var (markdown, error) = await ReadMarkdownInput(maxBytes);
                if (_disposed) return;
                _inputError = error;
                if (markdown is null) return;
                _markdown = markdown;
                await OnSave.InvokeAsync(markdown);
            }
            finally { _readingForSave = false; }
        }
        else await OnSave.InvokeAsync(_markdown);
    }
}
