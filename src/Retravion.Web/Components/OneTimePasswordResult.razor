<MudPaper Class="pa-6" Elevation="0" role="status">
    <h2>Account created</h2>
    <p>Save this temporary password now and share it securely. It cannot be retrieved later.</p>
    <p>The user must replace it before accessing the workspace.</p>
    <label for="temporary-password">Temporary password</label>
    <input id="temporary-password" type="text" readonly value="@Password" autocomplete="off"
           spellcheck="false" style="display:block;font-family:monospace;margin:1rem 0;padding:0.75rem;max-width:100%" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnDismiss">I have saved the password</MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Password { get; set; } = "";
    [Parameter] public EventCallback OnDismiss { get; set; }
}
