<MudDialog @ref="_dialog" Visible="true" Options="Options" AriaLabel="@Title">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">Save this temporary password now and share it securely. It cannot be retrieved later.</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">The user must replace it before accessing the workspace.</MudText>
        <MudTextField T="string" Value="@Password" Label="Temporary password" ReadOnly="true"
                      Variant="Variant.Outlined" Class="mt-4" autocomplete="off" spellcheck="false"
                      Style="font-family:monospace" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Dismiss">I have saved the password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string Title { get; set; } = "Account created";
    [Parameter, EditorRequired] public string Password { get; set; } = "";
    [Parameter] public EventCallback OnDismiss { get; set; }

    private MudDialog? _dialog;
    private static readonly DialogOptions Options = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        BackdropClick = false,
        CloseOnEscapeKey = false,
        CloseButton = false
    };

    private async Task Dismiss()
    {
        if (_dialog is not null) await _dialog.CloseAsync();
        await OnDismiss.InvokeAsync();
    }
}
