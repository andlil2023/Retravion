@page "/"
@layout LoginLayout
@inject NavigationManager Navigation

<PageTitle>Retravion</PageTitle>

<main class="login-page">
    <MudPaper Elevation="0" Class="login-panel">
        <div class="brand-mark" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Large" />
        </div>
        <p class="eyebrow">PRODUCT LIFECYCLE DOCUMENTATION</p>
        <h1>Retravion</h1>
        <p class="login-intro">A clear view of your product lifecycle.</p>

        <form @onsubmit="OpenHome" @onsubmit:preventDefault novalidate aria-label="Login prototype">
            <label for="username">Username</label>
            <input id="username" type="text" autocomplete="off" placeholder="Your username" />

            <label for="password">Password</label>
            <input id="password" type="password" autocomplete="off" placeholder="Your password" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" DropShadow="false" Class="login-button">
                Log in
            </MudButton>
            <p class="prototype-note">UI prototype only. No authentication or validation.<br />Do not enter real credentials.</p>
        </form>
    </MudPaper>
</main>

@code {
    private void OpenHome() => Navigation.NavigateTo("/home");
}
