@using System.Globalization
@using Retravion.Application.AuditTrail

<details class="audit-event-details">
    <summary>View details</summary>
    <div class="event-content">
        <h3>Recorded event</h3>
        <dl>
            <dt>Actor</dt><dd>@(Event.Actor is AuditActor.Identified actor ? $"Identified: {actor.Identifier}" : "Unknown")</dd>
            <dt>Time (UTC)</dt><dd><time datetime="@Event.OccurredAt.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@Event.OccurredAt.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)</time></dd>
            <dt>Action</dt><dd>@Event.Action</dd>
            <dt>Target</dt><dd>@(Event.ProductChange is { } product ? $"Identified: {product.After.Id}" : Event.UserNeedChange is { } need ? $"Identified: {need.After.Id}" : Event.RequirementChange is { } requirement ? $"Identified: {requirement.After.Id}" : Event.TestCaseChange is { } testCase ? $"Identified: {testCase.After.Id}" : Event.Target switch { AuditTarget.Identified target => $"Identified: {target.Identifier}", AuditTarget.Unknown => "Unknown", _ => "Not applicable" })</dd>
            <dt>Outcome</dt><dd>@Event.Outcome</dd>
        </dl>
        @if (Event.RevisionChange is { } revision)
        {
            <h3>Revision evidence</h3>
            <p>Operation: @revision.OperationId · Revision: @revision.InternalId</p>
            @if (revision.SourceRevisionInternalId is { } sourceId)
            { <p>Copied from Released revision: @sourceId</p> }
            @foreach (var entry in new[] { (Label: "Prior values", Values: revision.Before), (Label: "New values", Values: revision.After) })
            {
                <section aria-label="@entry.Label">
                    <h4>@entry.Label</h4>
                    @if (entry.Values is { } values)
                    {
                        <dl><dt>Identifier</dt><dd>@values.Identifier</dd><dt>Description</dt><dd class="recorded-value">@values.Description</dd><dt>State</dt><dd>@values.State</dd></dl>
                        <ul>
                            @foreach (var endpoint in values.Selections)
                            {
                                var feature = endpoint.Kind == Retravion.Domain.Revision.RevisionEntityKind.UserNeed ? "user-needs" : endpoint.Kind == Retravion.Domain.Revision.RevisionEntityKind.Requirement ? "requirements" : "test-cases";
                                <li><a href="@($"/{feature}/details?id={endpoint.InternalId}&version={endpoint.VersionId}")">@endpoint.Kind · v@endpoint.VersionNumber · @endpoint.InternalId / @endpoint.VersionId</a></li>
                            }
                        </ul>
                        @if (values.Selections.IsEmpty) { <p>No explicit selections.</p> }
                        @if (values.Release is { } release)
                        {
                            <h4>Frozen release and permanent protection</h4>
                            <p>@release.Actor · @release.OccurredAt.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)</p>
                            <ul aria-label="Protected release members">
                                @foreach (var member in release.Members)
                                { <li>@member.Endpoint.Kind @member.Identifier · v@member.Endpoint.VersionNumber · @member.Endpoint.InternalId / @member.Endpoint.VersionId · @(member.Explicit ? "Explicit" : "Indirect") · Approved and permanently protected</li> }
                            </ul>
                        }
                    }
                    else { <p>@(revision.Before is null ? "Not yet created" : "Deleted")</p> }
                </section>
            }
        }
        else if (Event.ProductChange is { } change)
        {
            <h3>@(change.Before is null ? "Initial Product values" : "Changed Product fields")</h3>
            @foreach (var field in Fields(change))
            {
                <section class="field-change" aria-label="@field.Name">
                    <h4>@field.Name</h4>
                    <dl>
                        @if (change.Before is not null)
                        {
                            <dt>Old value</dt><dd class="recorded-value">@(field.Old == "" ? "(empty)" : field.Old)</dd>
                        }
                        <dt>@(change.Before is null ? "Initial value" : "New value")</dt><dd class="recorded-value">@(field.New == "" ? "(empty)" : field.New)</dd>
                    </dl>
                </section>
            }
            @if (!Fields(change).Any())
            {
                <p>No recorded field changes.</p>
            }
        }
        else if (Event.UserNeedChange is { } needChange)
        {
            <h3>@(needChange.Before is null ? "Initial User Need values" : "Changed User Need fields")</h3>
            @foreach (var field in NeedFields(needChange))
            {
                <section class="field-change" aria-label="@field.Name">
                    <h4>@field.Name</h4>
                    <dl>
                        @if (needChange.Before is not null)
                        {
                            <dt>Old value</dt><dd class="recorded-value">@(field.Old == "" ? "(empty)" : field.Old)</dd>
                        }
                        <dt>@(needChange.Before is null ? "Initial value" : "New value")</dt><dd class="recorded-value">@(field.New == "" ? "(empty)" : field.New)</dd>
                    </dl>
                </section>
            }
            @if (needChange.Decision is not null)
            {
                <h3>Review decision</h3>
                <dl><dt>Decision</dt><dd class="recorded-value">@needChange.Decision</dd>
                    <dt>Comment</dt><dd class="recorded-value">@(needChange.Comment is null ? "(not provided)" : needChange.Comment == "" ? "(empty)" : needChange.Comment)</dd></dl>
            }
            @if (!NeedFields(needChange).Any() && needChange.Decision is null)
            {
                <p>No recorded field changes.</p>
            }
        }
        else if (Event.TestCaseChange is { } testCaseChange)
        {
            <h3>@(testCaseChange.Before is null ? "Initial Test Case values" : "Changed Test Case fields")</h3>
            @foreach (var field in TestCaseFields(testCaseChange))
            {
                <section class="field-change" aria-label="@field.Name">
                    <h4>@field.Name</h4>
                    <dl>
                        @if (testCaseChange.Before is not null)
                        { <dt>Old value</dt><dd class="recorded-value">@(field.Old == "" ? "(empty)" : field.Old)</dd> }
                        <dt>@(testCaseChange.Before is null ? "Initial value" : "New value")</dt><dd class="recorded-value">@(field.New == "" ? "(empty)" : field.New)</dd>
                    </dl>
                </section>
            }
            <dl>
                <dt>Version</dt><dd>@($"v{testCaseChange.VersionNumber}")</dd>
                @if (testCaseChange.SourceVersionId is { } source)
                { <dt>Source version</dt><dd><a href="@($"/test-cases/details?id={testCaseChange.InternalId}&version={source}")">Exact source Test Case version</a></dd> }
                @if (testCaseChange.Decision is not null)
                { <dt>Decision</dt><dd>@testCaseChange.Decision</dd><dt>Comment</dt><dd class="recorded-value">@(testCaseChange.Comment ?? "Not provided")</dd> }
                @if (testCaseChange.Reason is not null)
                { <dt>@(testCaseChange.Decision == "Reopened" ? "Reopening reason" : "Successor reason")</dt><dd class="recorded-value">@testCaseChange.Reason</dd> }
                @if (testCaseChange.Before?.Links is { } oldLinks)
                {
                    <dt>Old exact Requirement endpoints</dt><dd><ul>
                        @foreach (var endpoint in oldLinks)
                        { <li><a href="@($"/requirements/details?id={endpoint.RequirementInternalId}&version={endpoint.RequirementVersionId}")">Exact Requirement version</a></li> }
                    </ul>@(oldLinks.Count == 0 ? "None" : "")</dd>
                }
                @if (testCaseChange.After.Links is { } newLinks)
                {
                    <dt>New exact Requirement endpoints</dt><dd><ul>
                        @foreach (var endpoint in newLinks)
                        { <li><a href="@($"/requirements/details?id={endpoint.RequirementInternalId}&version={endpoint.RequirementVersionId}")">Exact Requirement version</a></li> }
                    </ul>@(newLinks.Count == 0 ? "None" : "")</dd>
                }
            </dl>
        }
        else if (Event.AiWorkflowChange is { } settings)
        {
            <h3>AI Workflow settings</h3>
            <section class="field-change" aria-label="MCP enabled">
                <h4>MCP enabled</h4>
                <dl><dt>Old value</dt><dd>@settings.Before</dd><dt>New value</dt><dd>@settings.After</dd></dl>
            </section>
        }
        else if (Event.RequirementChange is { } requirementChange)
        {
            <h3>@(requirementChange.Before is null ? "Initial Requirement values" : "Changed Requirement fields")</h3>
            @foreach (var field in RequirementFields(requirementChange))
            {
                <section class="field-change" aria-label="@field.Name">
                    <h4>@field.Name</h4>
                    <dl>
                        @if (requirementChange.Before is not null)
                        { <dt>Old value</dt><dd class="recorded-value">@(field.Old is null ? "(not provided)" : field.Old == "" ? "(empty)" : field.Old)</dd> }
                        <dt>@(requirementChange.Before is null ? "Initial value" : "New value")</dt><dd class="recorded-value">@(field.New is null ? "(not provided)" : field.New == "" ? "(empty)" : field.New)</dd>
                    </dl>
                </section>
            }
            @if (requirementChange.Decision is not null)
            {
                <h3>Review decision</h3>
                <dl><dt>Decision</dt><dd class="recorded-value">@requirementChange.Decision</dd>
                    <dt>Comment</dt><dd class="recorded-value">@(requirementChange.Comment is null ? "(not provided)" : requirementChange.Comment == "" ? "(empty)" : requirementChange.Comment)</dd></dl>
            }
            @if (!RequirementFields(requirementChange).Any() && requirementChange.Decision is null)
            { <p>No recorded field changes.</p> }
        }
        else
        {
            <p>No recorded field changes.</p>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public AuditInformation Event { get; set; } = default!;

    private static IEnumerable<(string Name, string? Old, string New)> TestCaseFields(TestCaseAuditDetails change)
    {
        static string Steps(TestCaseAuditValues value) => string.Join("\n\n", value.Steps.Select((step, index) =>
            $"Step {index + 1}\nAction: {step.Action}\nExpected result: {step.ExpectedResult}"));
        var before = change.Before;
        var after = change.After;
        (string Name, string? Old, string New)[] fields =
        [
            ("Test Case ID", before?.Id, after.Id),
            ("Version", change.VersionNumber.ToString(), change.VersionNumber.ToString()),
            ("Title", before?.Title, after.Title),
            ("Description", before?.Description, after.Description),
            ("Preconditions", before?.Preconditions, after.Preconditions),
            ("Status", before?.Status, after.Status),
            ("Ordered steps", before is null ? null : Steps(before), Steps(after))
        ];
        return fields.Where(field => before is null || field.Old != field.New);
    }

    private static IEnumerable<(string Name, string? Old, string New)> NeedFields(UserNeedAuditDetails change)
    {
        var before = change.Before;
        var after = change.After;
        (string Name, string? Old, string New)[] fields =
        [
            ("User Need ID", before?.Id, after.Id),
            ("Title", before?.Title, after.Title),
            ("Statement", before?.Statement, after.Statement),
            ("Status", before?.Status, after.Status)
        ];
        // Product internal IDs are retained in the audit payload but are not displayed to users (REQ-PRODUCT-001).
        return fields.Where(field => before is null || field.Old != field.New);
    }

    private static IEnumerable<(string Name, string? Old, string? New)> RequirementFields(RequirementAuditDetails change)
    {
        var before = change.Before;
        var after = change.After;
        (string Name, string? Old, string? New)[] fields =
        [
            ("Requirement ID", before?.Id, after.Id),
            ("Title", before?.Title, after.Title),
            ("Statement", before?.Statement, after.Statement),
            ("Type", before?.Type, after.Type),
            ("Rationale", before?.Rationale, after.Rationale),
            ("Status", before?.Status, after.Status)
        ];
        return fields.Where(field => before is null || field.Old != field.New);
    }

    private static IEnumerable<(string Name, string? Old, string New)> Fields(ProductAuditDetails change)
    {
        var before = change.Before;
        var after = change.After;
        (string Name, string? Old, string New)[] fields =
        [
            ("Product ID", before?.Id, after.Id),
            ("Name", before?.Name, after.Name),
            ("Kind", before?.Kind, after.Kind),
            ("Description", before?.Description, after.Description),
            ("Active", before?.IsActive.ToString(), after.IsActive.ToString())
        ];
        return fields.Where(field => before is null || field.Old != field.New);
    }
}
