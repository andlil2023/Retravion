@page "/"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms
@using Retravion.Identity.Application

<PageTitle>Retravion</PageTitle>

<main class="login-page">
    <MudPaper Elevation="0" Class="login-panel">
        <div class="brand-mark" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Large" />
        </div>
        <p class="eyebrow">PRODUCT LIFECYCLE DOCUMENTATION</p>
        <h1>Retravion</h1>
        <p class="login-intro">A clear view of your product lifecycle.</p>

        <form method="post" action="/identity/login" data-enhance="false" aria-label="Login">
            <AntiforgeryToken />
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" placeholder="Your username" />

            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Your password" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" DropShadow="false" Class="login-button">
                Log in
            </MudButton>
            @if (Failed)
            {
                <p role="alert">@PasswordSignIn.FailureMessage</p>
            }
        </form>
    </MudPaper>
</main>

@code {
    [SupplyParameterFromQuery(Name = "failed")]
    public bool Failed { get; set; }
}
