@page "/password-replacement"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Replace password · Retravion</PageTitle>

<main class="login-page">
    <MudPaper Elevation="0" Class="login-panel">
        <h1>Replace your initial password</h1>
        <p>You must replace your initial password before continuing.</p>
        <p id="password-rules">Use a different password with 10–30 Unicode characters and at least three of:
            lowercase letters (a–z), uppercase letters (A–Z), digits (0–9), and punctuation or symbols.</p>
        <form method="post" action="/identity/password-replacement" data-enhance="false" aria-label="Replace password">
            <AntiforgeryToken />
            <label for="current-password">Current password</label>
            <input id="current-password" name="currentPassword" type="password" autocomplete="current-password" />
            <label for="new-password">New password</label>
            <input id="new-password" name="newPassword" type="password" autocomplete="new-password" aria-describedby="password-rules" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" DropShadow="false" Class="login-button">
                Replace password
            </MudButton>
            @if (Failed)
            {
                <p role="alert">Password replacement failed. Check your current password and use a different password that meets the rules.</p>
            }
        </form>
    </MudPaper>
</main>

@code {
    [SupplyParameterFromQuery(Name = "failed")]
    public bool Failed { get; set; }
}
