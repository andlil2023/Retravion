@page "/administration/users/details/{Username}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Administrator")]
@using Retravion.Identity.Application
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Retravion.Web.Components
@inject UserOperations Operations
@inject AuthenticationStateProvider Authentication
@inject IDialogService Dialogs

<PageTitle>User details · Retravion</PageTitle>
<SectionContent SectionName="account-page-header">
    <PageHeader Title="User details" BackHref="/administration/users" />
</SectionContent>
@if (_reset is not null)
{
    <OneTimePasswordResult Title="Password reset" Password="@_reset.TemporaryPassword" OnDismiss="DismissPassword" />
}
@if (_feedback is not null)
{
    <MudAlert Severity="@(_failed ? Severity.Error : Severity.Success)" role="status">@_feedback</MudAlert>
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
}
else if (_account is not null)
{
    <section class="account-details" aria-labelledby="account-heading">
        <MudPaper id="account-details-card" Class="pa-4" Elevation="0">
            <h2 id="account-heading">@_account.DisplayName</h2>
            <dl>
                <div class="identity-row">
                    <dt>Username</dt>
                    <dd>@_account.Username</dd>
                </div>
                <div class="identity-row">
                    <dt>Display name</dt>
                    <dd>@_account.DisplayName</dd>
                </div>
                <div class="identity-row">
                    <dt>Account type</dt>
                    <dd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">@_account.AccountType</MudChip></dd>
                </div>
                <div class="identity-row">
                    <dt>Availability</dt>
                    <dd>@(_account.IsActive ? "Active" : "Inactive")</dd>
                </div>
            </dl>
            @if (_isSelf)
            {
                <p>You cannot inactivate your own account.</p>
                <p>You cannot reset your own password.</p>
            }
        </MudPaper>
        <div class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="min-height:44px"
                       Disabled="@(_busy || (_account.IsActive && _isSelf))" OnClick="ConfirmAvailability">
                @(_account.IsActive ? "Inactivate" : "Reactivate")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="min-height:44px" Class="ml-2"
                       Disabled="@(_busy || _isSelf || _reset is not null)" OnClick="ConfirmReset"
                       StartIcon="@Icons.Material.Outlined.LockReset">Reset password</MudButton>
        </div>
    </section>
}

@code {
    [Parameter] public string Username { get; set; } = "";
    private AccountSummary? _account;
    private string? _error;
    private string? _feedback;
    private bool _failed;
    private bool _isSelf;
    private bool _busy;
    private CreatedAccount? _reset;

    private void DismissPassword() => _reset = null;

    private async Task ConfirmReset()
    {
        if (_account is null || _busy || _isSelf || _reset is not null) return;
        _busy = true;
        _feedback = null;
        try
        {
            var target = _account;
            var confirmed = await Dialogs.ShowMessageBoxAsync("Reset password?",
                $"Reset the password for {target.DisplayName} ({target.Username})? All existing sessions will end and unsaved work may be lost. A new temporary password will be shown once. Account availability will not change.",
                yesText: "Reset password", cancelText: "Cancel");
            if (confirmed != true) return;
            var result = await Operations.ResetPassword((await Authentication.GetAuthenticationStateAsync()).User, target.Username);
            _failed = result.IsFailure;
            if (result.IsFailure) _feedback = result.Error;
            else _reset = result.Value;
            await RefreshAccount();
        }
        finally { _busy = false; }
    }

    private async Task ConfirmAvailability()
    {
        if (_account is null || _busy) return;
        _busy = true;
        _feedback = null;
        try
        {
            var target = _account;
            var action = target.IsActive ? "Inactivate" : "Reactivate";
            var confirmed = await Dialogs.ShowMessageBoxAsync($"{action} user?",
                $"{action} {target.DisplayName} ({target.Username})? " +
                (target.IsActive ? "Subsequent sign-in will be blocked." : "Other authentication restrictions will still apply."),
                yesText: action, cancelText: "Cancel");
            if (confirmed != true) return;
            var result = await Operations.ChangeAvailability((await Authentication.GetAuthenticationStateAsync()).User,
                target.Username, !target.IsActive);
            _failed = result.IsFailure;
            _feedback = result.IsFailure ? result.Error : $"{target.Username} is now {(target.IsActive ? "inactive" : "active")}.";
            await RefreshAccount();
        }
        finally { _busy = false; }
    }
    protected override async Task OnParametersSetAsync()
    {
        _reset = null;
        await RefreshAccount();
    }

    private async Task RefreshAccount()
    {
        _account = null;
        _error = null;
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        _isSelf = string.Equals(actor.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, Username,
            StringComparison.OrdinalIgnoreCase);
        var result = await Operations.List(actor);
        if (result.IsFailure) _error = result.Error;
        else
        {
            _account = result.Value.FirstOrDefault(account => string.Equals(account.Username, Username, StringComparison.OrdinalIgnoreCase));
            if (_account is null) _error = "User not found.";
        }
    }
}
