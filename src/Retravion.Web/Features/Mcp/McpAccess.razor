@page "/settings/ai-workflow"
@page "/mcp-access"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CompletedPasswordReplacement")]
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Retravion.Application.AiWorkflow
@using MudBlazor
@using Retravion.Web.Components
@inject AiWorkflowOperations Operations
@inject AuthenticationStateProvider Authentication

<PageTitle>AI Workflow · Retravion</PageTitle>
<SectionContent SectionName="mcp-page-header">
    <PageHeader Title="AI Workflow" BackHref="/home" BackText="Home" />
</SectionContent>
<div class="ai-workflow">
    @if (_administrator)
    {
        <MudButton Href="/settings/mcp" Variant="Variant.Text" Class="mb-4">MCP settings</MudButton>
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error Credential creation is unavailable.</MudAlert>
    }
    else if (_settings?.Enabled == false)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">MCP is disabled for all users. Ask an administrator to enable it before creating a credential. Browser access is unaffected.</MudAlert>
    }
    <MudPaper Class="pa-4" Elevation="0">
        <MudText Typo="Typo.h6" HtmlTag="h2">Your terminal credential</MudText>
        <p>Connect Pi or Claude Code on this machine to <code>/mcp</code> as your signed-in user. Remote access is not supported.</p>
        <p>A new credential replaces this browser session's previous credential. It expires after 30 minutes or when this session ends. Logging out ends its MCP access.</p>
        <p>Creation opens JSON: copy the token privately to your terminal, then return here. Never put it in prompts, source files, shared configuration or logs.</p>
        <details>
            <summary>What MCP can do</summary>
            <p>Read Products and all User Need, Requirement and Test Case statuses; create or edit Draft needs, requirements and test cases under active Products. It cannot modify Products, change lifecycle status, make review decisions or manage links. The downloadable skill guides Product reads and User Need Draft work only.</p>
        </details>
        <form id="mcp-issue-form" method="post" action="/identity/mcp-token" data-enhance="false"><AntiforgeryToken /></form>
        <form id="mcp-revoke-form" method="post" action="/identity/mcp-token/revoke" data-enhance="false" class="mt-4">
            <AntiforgeryToken />
            <label><input type="checkbox" required /> Confirm revoking this session's MCP credential</label>
        </form>
    </MudPaper>
    <div class="credential-actions mt-4 mb-6">
        <MudButton ButtonType="ButtonType.Submit" form="mcp-issue-form" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_settings?.Enabled != true)">Create MCP credential</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="mcp-revoke-form" Variant="Variant.Filled" Color="Color.Primary">Revoke MCP credential</MudButton>
    </div>

    <MudText Typo="Typo.h6" HtmlTag="h2">Terminal integrations</MudText>
    <p>Install your terminal separately. These downloads add instructions and configuration examples, not credentials or permissions.</p>
    @if (_packagesUnavailable)
    {
        <MudAlert Severity="Severity.Warning">Terminal skill download files are unavailable.</MudAlert>
    }
    <MudGrid Spacing="4">
        @foreach (var bundle in _bundles)
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h6" HtmlTag="h3">@(bundle.Client == "pi" ? "Pi" : "Claude Code")</MudText>
                    <p>Use the native MCP connection and <code>@(bundle.Client == "pi" ? "/skill:retravion" : "/retravion")</code> skill.</p>
                    <details>
                        <summary>Setup and checksum</summary>
                        <p>Extract and read the bundled README for installation, connection, updating and removal. Review the ZIP and merge only the Retravion files/entry; preserve unrelated client configuration. Updates and removal are manual.</p>
                        <p class="package-detail">Integration @TerminalPackages.Version · @bundle.FileName</p>
                        <p class="package-detail">SHA-256 (integrity, not publisher authentication): @bundle.Sha256</p>
                    </details>
                </MudPaper>
                <div class="mt-4">
                    <MudButton Href="@bundle.DownloadPath" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download">Download @(bundle.Client == "pi" ? "Pi" : "Claude Code") skills</MudButton>
                </div>
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    private AiWorkflowSettings? _settings;
    private string? _error;
    private bool _administrator;
    private bool _packagesUnavailable;
    private TerminalBundle[] _bundles = [];
    protected override async Task OnInitializedAsync()
    {
        var principal = (await Authentication.GetAuthenticationStateAsync()).User;
        var result = await Operations.Read(principal);
        if (result.IsFailure) _error = result.Error;
        else _settings = result.Value;
        _administrator = await Operations.CanConfigure(principal);
        try { _bundles = [TerminalPackages.Get("pi")!, TerminalPackages.Get("claude")!]; }
        catch (IOException) { _packagesUnavailable = true; }
    }
}
