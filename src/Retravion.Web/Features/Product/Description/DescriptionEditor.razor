<MudPaper Class="product-card" Elevation="0">
    <form id="@FormId" @onsubmit="Save" @onsubmit:preventDefault aria-label="@SubmitText">
        @ChildContent
        <div class="description-toolbar">
            <h2>@(Optional ? "Description (optional)" : "Description")</h2>
            <div class="description-tools" role="group" aria-label="Editor and preview arrangement">
                <MudIconButton Icon="@Icons.Material.Outlined.VerticalSplit" Class="product-button" Size="Size.Small"
                               Color="@(_arrangement == "side-by-side" ? Color.Primary : Color.Default)"
                               OnClick='@(() => _arrangement = "side-by-side")'
                               aria-label="Side by side" title="Side by side" aria-pressed="@(_arrangement == "side-by-side")" />
                <MudIconButton Icon="@Icons.Material.Outlined.HorizontalSplit" Class="product-button" Size="Size.Small"
                               Color="@(_arrangement == "stacked" ? Color.Primary : Color.Default)"
                               OnClick='@(() => _arrangement = "stacked")'
                               aria-label="Stacked" title="Stacked" aria-pressed="@(_arrangement == "stacked")" />
            </div>
        </div>
        <div class="description-layout @_arrangement">
            <div class="description-source">
                <label for="product-markdown">Description (Markdown)</label>
                <textarea id="product-markdown" value="@_markdown" @oninput="Edit" disabled="@Busy" rows="12" spellcheck="true"></textarea>
            </div>
            <section aria-label="Description preview" class="description-preview">
                <h3>Preview</h3>
                @((MarkupString)ProductMarkdown.Render(_markdown))
            </section>
        </div>
    </form>
</MudPaper>
<div class="product-actions">
    <MudButton ButtonType="ButtonType.Submit" form="@FormId" Variant="Variant.Filled" Color="Color.Primary"
               Disabled="Busy" Class="product-button">@SubmitText</MudButton>
    @if (CancelHref is not null)
    {
        <MudButton Href="@CancelHref" Class="product-button">Cancel</MudButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public string InitialDescription { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string FormId { get; set; } = "product-description-form";
    [Parameter] public string SubmitText { get; set; } = "Save description";
    [Parameter] public string? CancelHref { get; set; }
    [Parameter] public bool Optional { get; set; }
    private string _markdown = "";
    private string _arrangement = "side-by-side";
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _markdown = InitialDescription;
        _initialized = true;
    }

    private void Edit(ChangeEventArgs args) => _markdown = args.Value?.ToString() ?? "";
    private Task Save() => Busy ? Task.CompletedTask : OnSave.InvokeAsync(_markdown);
}
