@page "/products"
@inject NavigationManager Navigation

<PageTitle>Products · Retravion</PageTitle>
<SectionContent SectionName="product-page-header">
    <PageHeader Title="Products">
        <Actions><MudButton Class="product-button" Href="/products/create" StartIcon="@Icons.Material.Outlined.Add">Create Product</MudButton></Actions>
    </PageHeader>
</SectionContent>
<MudPaper Class="product-card pa-4" Elevation="0">
    <form id="retrieve-product-form" @onsubmit="Retrieve" @onsubmit:preventDefault aria-label="Retrieve Product">
        <MudTextField @bind-Value="_id" Label="Product ID" Variant="Variant.Outlined" Required="true" />
    </form>
</MudPaper>
<div class="product-actions">
    <MudButton ButtonType="ButtonType.Submit" form="retrieve-product-form" Variant="Variant.Filled" Color="Color.Primary" Class="product-button">Retrieve Product</MudButton>
</div>

@code {
    private string _id = "";
    private void Retrieve() => Navigation.NavigateTo($"/products/details?id={Uri.EscapeDataString(_id)}");
}
