@page "/products/details"
@using Retravion.Web.Features.Product.Description
@inject ProductOperations Operations
@inject AuthenticationStateProvider Authentication

<PageTitle>Product details · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="Product details" BackHref="/products" BackText="Products" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_product is not null)
{
    <section aria-labelledby="product-heading">
        <div class="product-heading">
            <h2 id="product-heading">@_product.Id – @_product.Name</h2>
            <span class="product-status">@(_product.IsActive ? "Active" : "Retired")</span>
            <dl class="product-kind"><dt>Kind</dt><dd>@KindLabel(_product.Kind)</dd></dl>
        </div>
        <MudPaper id="product-details-card" Class="product-card product-document" Elevation="0">
            <article aria-label="Product description" class="product-markdown">
                @if (string.IsNullOrEmpty(_product.Description)) { <p class="product-empty">No description yet.</p> }
                else { @((MarkupString)ProductMarkdown.Render(_product.Description)) }
            </article>
        </MudPaper>
        <div class="product-actions"><MudButton Href="@($"/products/edit?id={Uri.EscapeDataString(_product.Id)}")" Variant="Variant.Filled" Color="Color.Primary" Class="product-button">Edit</MudButton></div>
    </section>
}
@code {
    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }
    private Retravion.Domain.Product.Product? _product;
    private string? _error;
    private static string KindLabel(Retravion.Domain.Product.ProductKind kind) => kind switch {
        Retravion.Domain.Product.ProductKind.SoftwareApplication => "Software application",
        Retravion.Domain.Product.ProductKind.HardwareDevice => "Hardware device",
        _ => kind.ToString()
    };
    protected override async Task OnParametersSetAsync()
    {
        _product = null;
        var result = await Operations.Retrieve((await Authentication.GetAuthenticationStateAsync()).User, Id);
        _error = result.IsFailure ? result.Error : null;
        if (result.IsSuccess) _product = result.Value;
    }
}
