@page "/products/details"
@using Retravion.Web.Features.Product.Description
@inject ProductOperations Operations
@inject AuthenticationStateProvider Authentication
@inject IDialogService Dialogs

<PageTitle>Product details · Retravion</PageTitle>
<SectionContent SectionName="product-page-header">
    <PageHeader Title="Product details" BackHref="/products" BackText="Products" />
</SectionContent>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
}
@if (_feedback is not null)
{
    <MudAlert Severity="Severity.Success" role="status">@_feedback</MudAlert>
}
@if (_product is not null)
{
    <section aria-labelledby="product-heading">
        <div class="product-heading">
            <h2 id="product-heading">@_product.Id – @_product.Name</h2>
            <span class="product-status">@(_product.IsActive ? "Active" : "Retired")</span>
            <span>Kind: @KindLabel(_product.Kind)</span>
        </div>
        <MudPaper id="product-details-card" Class="product-card product-document" Elevation="0">
            <article aria-label="Product description" class="product-markdown">
                @if (string.IsNullOrEmpty(_product.Description))
                {
                    <p class="product-empty">No description yet.</p>
                }
                else
                {
                    @((MarkupString)ProductMarkdown.Render(_product.Description))
                }
            </article>
        </MudPaper>
        <div class="product-actions">
            @if (_product.IsActive)
            {
                <MudButton Href="@($"/products/description?id={Uri.EscapeDataString(_product.Id)}")" Variant="Variant.Filled" Color="Color.Primary" Class="product-button">Edit description</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="product-button product-status-action" Disabled="_busy" OnClick="ConfirmStatus">
                @(_product.IsActive ? "Retire" : "Reactivate")
            </MudButton>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }
    private Retravion.Domain.Product.Product? _product;
    private string? _error;
    private string? _feedback;
    private bool _busy;
    private static string KindLabel(Retravion.Domain.Product.ProductKind kind) => kind switch
    {
        Retravion.Domain.Product.ProductKind.SoftwareApplication => "Software application",
        Retravion.Domain.Product.ProductKind.HardwareDevice => "Hardware device",
        _ => kind.ToString()
    };

    protected override async Task OnParametersSetAsync()
    {
        _feedback = null;
        await Refresh();
    }

    private async Task Refresh()
    {
        _product = null;
        var result = await Operations.Retrieve((await Authentication.GetAuthenticationStateAsync()).User, Id);
        _error = result.IsFailure ? result.Error : null;
        if (result.IsSuccess) _product = result.Value;
    }

    private async Task ConfirmStatus()
    {
        if (_busy || _product is null) return;
        _busy = true;
        _error = null;
        _feedback = null;
        var target = _product;
        try
        {
            var action = target.IsActive ? "Retire" : "Reactivate";
            var confirmed = await Dialogs.ShowMessageBoxAsync($"{action} Product?",
                $"{action} {target.Name} ({target.Id})?", yesText: action, cancelText: "Cancel");
            if (confirmed != true) return;
            var result = await Operations.ChangeStatus((await Authentication.GetAuthenticationStateAsync()).User,
                target.Id, target.InternalId, !target.IsActive);
            await Refresh();
            if (result.IsFailure) _error = result.Error;
            else _feedback = $"Product is now {(result.Value.IsActive ? "active" : "retired")}.";
        }
        finally { _busy = false; }
    }
}
