@page "/products/links"
@using Retravion.Application.Requirement
@inject RelationshipOperations Operations
@inject AuthenticationStateProvider Authentication

<PageTitle>Links · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="Links" BackHref="@(_view?.Center.DetailsPath ?? "/products")" BackText="Details" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
else if (_view is null) { <p role="status">Loading relationships…</p> }
else
{
    <MudPaper Class="pa-4" Elevation="0">
        <h2>Center: @_view.Center.Label</h2>
        @NodeContent(_view.Center)
        <p>Initially only direct relationships are loaded. Expand a connected exact version to reveal its neighborhood without changing the center.
            Following its name makes it the center. Collapse hides branches, never deletes links; shared branches remain when reachable through another expanded entity.</p>
        <p>Each relationship belongs to its Requirement or Test Case owner, not necessarily the center. Only editable Draft owners can change links; Approved targets can receive incoming links. Each action saves immediately.</p>
        <p role="status">@_view.Edges.Count direct relationship(s). @_edges.Count relationship(s) in the explored view.</p>
    </MudPaper>
    @if (_message is not null)
    {
        <MudAlert Severity="@(_requiresRetrieval ? Severity.Error : Severity.Success)" role="status">@_message</MudAlert>
    }
    @if (_requiresRetrieval)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Retrieve">Retrieve relationships before another action</MudButton>
    }
    @if (_anchor is not null)
    {
        <MudPaper Class="pa-4 my-4" Elevation="0">
            <h3>Add @(_incoming ? "incoming" : "outgoing") link: @_anchor.Label</h3>
            <p>Product: @ProductOf(_anchor).Id – @ProductOf(_anchor).Name. Select an existing exact version; no entities are created here.</p>
            @if (_anchor.Kind == "requirement")
            {
                <MudSelect T="string" Value="_relationship" ValueChanged="SelectRelationship" Label="Relationship" Disabled="_busy">
                    @if (!_incoming)
                    { <MudSelectItem Value="@(RelationshipOperations.NeedRelationship)">@RelationshipOperations.NeedRelationship</MudSelectItem> }
                    <MudSelectItem Value="@(RelationshipOperations.ParentRelationship)">@RelationshipOperations.ParentRelationship</MudSelectItem>
                    @if (_incoming)
                    { <MudSelectItem Value="@(RelationshipOperations.TestCaseRelationship)">@RelationshipOperations.TestCaseRelationship</MudSelectItem> }
                </MudSelect>
            }
            else { <p>@_relationship</p> }
            @if (_incoming) { <p>Select the editable Draft owner of this incoming reference.</p> }
            <MudSelect T="Guid?" @bind-Value="_selected" Label="Existing exact version" Disabled="@(_busy || _candidateError is not null)">
                @foreach (var candidate in _candidates)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)candidate.VersionId)">@candidate.Label – @candidate.Title · @candidate.Status</MudSelectItem>
                }
            </MudSelect>
            <p>@_candidates.Count available exact version(s). All available versions are listed; scroll the selection list as needed.</p>
            @if (_candidateError is not null) { <MudAlert Severity="Severity.Error" role="alert">@_candidateError</MudAlert> }
            @if (SelectedCandidate is { } selected)
            {
                <p>@(_incoming ? selected.Label : _anchor.Label) → @_relationship → @(_incoming ? _anchor.Label : selected.Label)</p>
                <MudLink Href="@selected.DetailsPath" Target="_blank" rel="noopener">Inspect selected exact version (new tab)</MudLink>
            }
        </MudPaper>
        <div class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _selected is null || _candidateError is not null)" OnClick="AddLink" aria-label="Add selected link">Add link</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CancelAction">Cancel add</MudButton>
        </div>
    }
    @if (_retargeting is { } retargeting)
    {
        <MudPaper Class="pa-4 my-4" Elevation="0">
            <h3>Retarget @retargeting.Relationship</h3>
            <p>Owner: @retargeting.Owner.Label. Old exact target: @retargeting.Target.Label – @retargeting.Target.Title</p>
            <MudSelect T="Guid?" @bind-Value="_selected" Label="Replacement exact version" Disabled="@(_busy || _candidateError is not null)">
                @foreach (var candidate in _candidates)
                { <MudSelectItem T="Guid?" Value="@((Guid?)candidate.VersionId)">@candidate.Label – @candidate.Title · @candidate.Status</MudSelectItem> }
            </MudSelect>
            @if (_candidateError is not null) { <MudAlert Severity="Severity.Error" role="alert">@_candidateError</MudAlert> }
            @if (SelectedCandidate is { } replacement)
            {
                <p>Confirm old target @retargeting.Target.Label → new target @replacement.Label – @replacement.Title · @replacement.Status</p>
                <MudLink Href="@replacement.DetailsPath" Target="_blank" rel="noopener">Inspect replacement exact version (new tab)</MudLink>
            }
        </MudPaper>
        <div class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ActionsDisabled || _selected is null || _candidateError is not null)" OnClick="ConfirmRetarget" aria-label="Confirm selected retarget">Confirm retarget link</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CancelAction">Cancel retarget</MudButton>
        </div>
    }
    @if (_removing is { } removing)
    {
        <MudPaper Class="pa-4 my-4" Elevation="0">
            <h3>Confirm link removal</h3>
            <p>Remove @removing.Relationship: @removing.Owner.Label → @removing.Target.Label?</p>
            <p>@removing.Owner.Title → @removing.Target.Title</p>
        </MudPaper>
        <div class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="ConfirmRemoval" aria-label="Confirm selected removal">Confirm remove link</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CancelAction">Cancel removal</MudButton>
        </div>
    }
    <div class="my-4" role="group" aria-label="Relationship view">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => ChangeView(false))" aria-pressed="@(!_table)">Graph view</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => ChangeView(true))" aria-pressed="@_table">Table view</MudButton>
    </div>
    @foreach (var origin in _exploration!.UnavailableOrigins)
    {
        <MudPaper Class="pa-4 my-4" Elevation="0">
            <h3>Derived from — source unavailable</h3>
            <p>Copy: @origin.Copy.Label</p>
            <p>Stored source Product identity: @origin.SourceProductId; entity identity: @origin.SourceId; version identity: @origin.SourceVersionId</p>
            <p>@origin.SourceManualId · v@origin.SourceVersionNumber · @origin.SourceStatus (at copy time)</p>
            <p>@origin.SourceTitle</p><p>@origin.SourceStatement</p>
            @if (origin.SourceType is not null) { <p>Type: @origin.SourceType</p> }
            @if (origin.SourceRationale is not null) { <p>Rationale: @origin.SourceRationale</p> }
        </MudPaper>
    }
    @if (_edges.Count == 0)
    {
        @if (_exploration.UnavailableOrigins.Count == 0) { <p>No direct relationships for this exact version.</p> }
    }
    else
    {
        <p role="status">Page @(_page + 1) of @PageCount. Showing @PageEdges.Count of @_edges.Count explored relationships.
            @(_edges.Count > PageEdges.Count ? "More relationships are on other pages." : "") Unexpanded neighborhoods may contain more relationships.</p>
        <div role="group" aria-label="Relationship pages">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _page == 0)" OnClick="@(() => ChangePage(_page - 1))">Previous relationships</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _page + 1 >= PageCount)" OnClick="@(() => ChangePage(_page + 1))">Next relationships</MudButton>
        </div>
        @if (_table)
        {
            <MudTable T="RelationshipEdge" Items="PageEdges" Dense="true" Hover="true" Elevation="0" aria-label="Explored relationships">
                <HeaderContent><MudTh>Direction / relationship</MudTh><MudTh>From (owner)</MudTh><MudTh>To (target)</MudTh><MudTh>Ownership state</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Direction / relationship">@Direction(context) · @RelationshipLabel(context)</MudTd>
                    <MudTd DataLabel="From (owner)">@NodeContent(context.Owner)</MudTd>
                    <MudTd DataLabel="To (target)">@NodeContent(context.Target)</MudTd>
                    <MudTd DataLabel="Ownership state">@context.Ownership(ProductOf(context.Owner).IsActive)@RemoveControl(context)</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <div class="relationship-graph" role="region" aria-label="Explored relationship graph" tabindex="0">
                <div class="branches">
                    <h3>Incoming →</h3>
                    @foreach (var edge in PageEdges.Where(e => e.Target.VersionId == _view.Center.VersionId))
                    {
                        <div class="branch incoming">
                            <MudPaper Class="pa-4" Elevation="0">
                                @NodeContent(edge.Owner)
                                <p>@RelationshipLabel(edge) → center</p>
                                <p>@edge.Ownership(ProductOf(edge.Owner).IsActive)</p>@RemoveControl(edge)
                            </MudPaper>
                            <span class="connector" aria-hidden="true">→</span>
                        </div>
                    }
                </div>
                <div class="graph-center"><MudPaper Class="pa-4" Elevation="0"><h3>Center</h3>@NodeContent(_view.Center)</MudPaper></div>
                <div class="branches">
                    <h3>→ Outgoing</h3>
                    @foreach (var edge in PageEdges.Where(e => e.Owner.VersionId == _view.Center.VersionId))
                    {
                        <div class="branch outgoing">
                            <span class="connector" aria-hidden="true">→</span>
                            <MudPaper Class="pa-4" Elevation="0">
                                <p>Center → @RelationshipLabel(edge)</p>
                                @NodeContent(edge.Target)
                                <p>@edge.Ownership(ProductOf(edge.Owner).IsActive)</p>@RemoveControl(edge)
                            </MudPaper>
                        </div>
                    }
                </div>
            </div>
            <h3>Indirect relationships</h3>
            @foreach (var edge in PageEdges.Where(e => Direction(e) == "Indirect"))
            {
                <MudPaper Class="pa-4 my-4" Elevation="0">
                    @NodeContent(edge.Owner)
                    <p>→ @RelationshipLabel(edge) →</p>
                    @NodeContent(edge.Target)
                    <p>@edge.Ownership(ProductOf(edge.Owner).IsActive)</p>@RemoveControl(edge)
                </MudPaper>
            }
        }
    }
}
@code {
    [SupplyParameterFromQuery(Name = "kind")] public string? Kind { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? VersionId { get; set; }
    private const int PageSize = 20;
    private RelationshipExploration? _exploration;
    private RelationshipView? _view => _exploration?.Root;
    private IReadOnlyList<RelationshipEdge> _edges = [];
    private string? _error, _message, _candidateError;
    private bool _busy, _requiresRetrieval, _incoming;
    private RelationshipNode? _anchor;
    private RelationshipEdge? _removing, _retargeting;
    private string _relationship = RelationshipOperations.NeedRelationship;
    private Guid? _selected;
    private IReadOnlyList<RelationshipNode> _candidates = [];
    private RelationshipNode? SelectedCandidate => _candidates.SingleOrDefault(n => n.VersionId == _selected);
    private bool ActionsDisabled => _busy || _requiresRetrieval;
    private bool _table;
    private int _load;
    private int _page;
    private int PageCount => Math.Max(1, (_edges.Count + PageSize - 1) / PageSize);
    private IReadOnlyList<RelationshipEdge> PageEdges => _edges.Skip(_page * PageSize).Take(PageSize).ToArray();

    protected override Task OnParametersSetAsync()
    {
        _page = 0; CancelAction(); _message = null; _requiresRetrieval = false;
        return Load([]);
    }
    private void CancelAction() { _anchor = null; _removing = null; _retargeting = null; _selected = null; _candidates = []; _candidateError = null; }
    private async Task Retrieve()
    {
        CancelAction(); _message = null; _requiresRetrieval = false;
        await Load(_exploration?.Expanded ?? []);
    }
    private async Task BeginAdd(RelationshipNode node, bool incoming)
    {
        if (ActionsDisabled || _view is null || !ProductOf(node).IsActive || (incoming && node.Kind == "test-case") || (!incoming && !node.Editable)) return;
        CancelAction(); _message = null; _anchor = node; _incoming = incoming;
        _relationship = node.Kind == "test-case" ? RelationshipOperations.TestCaseRelationship
            : incoming && node.Kind == "requirement" ? RelationshipOperations.ParentRelationship : RelationshipOperations.NeedRelationship;
        await LoadCandidates();
    }
    private async Task SelectRelationship(string relationship)
    {
        if (_busy) return;
        _relationship = relationship; await LoadCandidates();
    }
    private async Task LoadCandidates()
    {
        if (_anchor is null) return;
        _busy = true; _selected = null; _candidates = []; _candidateError = null;
        var anchor = _anchor;
        var load = _load;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = await Operations.Candidates(actor, anchor.ProductInternalId,
                _relationship == RelationshipOperations.TestCaseRelationship ? (_incoming ? "test-case" : "requirement")
                    : _incoming || _relationship == RelationshipOperations.ParentRelationship ? "requirement" : "user-need", _incoming);
            if (load != _load || _anchor != anchor) return;
            if (result.IsFailure) _candidateError = result.Error;
            else _candidates = result.Value;
        }
        finally { _busy = false; }
    }
    private async Task AddLink()
    {
        if (ActionsDisabled || _anchor is null || SelectedCandidate is not { } selected) return;
        var owner = _incoming ? selected : _anchor;
        var target = _incoming ? _anchor : selected;
        await Save(owner, target, _relationship, "add");
    }
    private void BeginRemoval(RelationshipEdge edge)
    {
        if (ActionsDisabled || _view is null || edge.IsProvenance || !ProductOf(edge.Owner).IsActive || !edge.Owner.Editable) return;
        CancelAction(); _message = null; _removing = edge;
    }
    private async Task ConfirmRemoval()
    {
        if (ActionsDisabled || _removing is not { } edge) return;
        await Save(edge.Owner, edge.Target, edge.Relationship, "remove");
    }
    private async Task BeginRetarget(RelationshipEdge edge)
    {
        if (ActionsDisabled || _view is null || edge.IsProvenance || !ProductOf(edge.Owner).IsActive || !edge.Owner.Editable) return;
        CancelAction(); _message = null; _retargeting = edge; _busy = true;
        var load = _load;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = await Operations.Candidates(actor, edge.Owner.ProductInternalId, edge.Target.Kind, false);
            if (load != _load || _retargeting != edge) return;
            if (result.IsFailure) _candidateError = result.Error;
            else _candidates = result.Value.Where(n => n.InternalId == edge.Target.InternalId && n.VersionId != edge.Target.VersionId).ToArray();
        }
        finally { _busy = false; }
    }
    private async Task ConfirmRetarget()
    {
        if (ActionsDisabled || _retargeting is not { } edge || SelectedCandidate is not { } replacement) return;
        await Save(edge.Owner, edge.Target, edge.Relationship, "retarget", replacement);
    }
    private async Task Save(RelationshipNode owner, RelationshipNode target, string relationship, string operation, RelationshipNode? replacement = null)
    {
        _busy = true;
        var load = _load;
        var expanded = _exploration?.Expanded ?? [];
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = await Operations.Change(actor, owner, target, relationship, operation, replacement);
            if (load != _load) return; // A completed mutation must not overwrite a newly navigated center.
            CancelAction();
            if (result.IsFailure)
            {
                _message = result.Error; _requiresRetrieval = true;
                // No automatic retry or optimistic success, including uncertain commit outcomes.
            }
            else
            {
                _message = operation == "add" ? "Link added." : operation == "remove" ? "Link removed." : "Link retargeted.";
                await Load(expanded); // Navigation during refresh clears the message; never republish it afterward.
            }
        }
        finally { _busy = false; }
    }
    private async Task ChangeView(bool table) { if (_busy) return; CancelAction(); _table = table; await Load(_exploration?.Expanded ?? []); }
    private async Task ChangePage(int page) { if (_busy) return; CancelAction(); _page = page; await Load(_exploration?.Expanded ?? []); }
    private async Task Toggle(RelationshipNode node)
    {
        if (_busy) return;
        CancelAction();
        var expanded = _exploration?.Expanded ?? [];
        _page = 0;
        await Load(expanded.Contains(node.VersionId)
            ? expanded.Where(id => id != node.VersionId).ToArray()
            : expanded.Append(node.VersionId).ToArray());
    }
    private async Task Load(IReadOnlyCollection<Guid> expanded)
    {
        var load = ++_load;
        _exploration = null; _edges = []; _error = null;
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        var result = await Operations.Explore(actor, Kind, Id, VersionId, expanded);
        if (load != _load) return; // An older async navigation must not replace the current center.
        if (result.IsFailure) _error = result.Error;
        else
        {
            _exploration = result.Value;
            _edges = result.Value.Edges;
            _page = Math.Clamp(_page, 0, PageCount - 1);
        }
    }
    private string Direction(RelationshipEdge edge) => edge.Owner.VersionId == _view!.Center.VersionId ? "Outgoing"
        : edge.Target.VersionId == _view.Center.VersionId ? "Incoming" : "Indirect";
    private Retravion.Domain.Product.Product ProductOf(RelationshipNode node) =>
        _exploration!.Products.Single(p => p.InternalId == node.ProductInternalId);
    private string RelationshipLabel(RelationshipEdge edge) => !edge.IsProvenance ? edge.Relationship
        : edge.Target.VersionId == _view!.Center.VersionId ? "Derived from (center is Source for this copy)" : "Derived from";
    private RenderFragment RemoveControl(RelationshipEdge edge) => @<div class="mt-4">
        @if (!edge.IsProvenance)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ActionsDisabled || !ProductOf(edge.Owner).IsActive || !edge.Owner.Editable)"
                OnClick="@(() => BeginRemoval(edge))" aria-label="@($"Remove {edge.Relationship}: {edge.Owner.Label} → {edge.Target.Label}")">Remove link</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ActionsDisabled || !ProductOf(edge.Owner).IsActive || !edge.Owner.Editable)"
                OnClick="@(() => BeginRetarget(edge))" aria-label="@($"Retarget {edge.Relationship}: {edge.Owner.Label} → {edge.Target.Label}")">Retarget link</MudButton>
        }
    </div>;
    private RenderFragment NodeContent(RelationshipNode node) => @<div class="relationship-node">
        <MudLink Href="@node.LinksPath">@node.Label</MudLink>
        <p>@node.Title</p>
        <p>Status: @node.Status</p>
        <p>Product: @ProductOf(node).Id – @ProductOf(node).Name @(!ProductOf(node).IsActive ? "(retired)" : "")</p>
        @if (node.HasNewerVersion) { <p>Newer version available; showing this exact version.</p> }
        <MudLink Href="@node.DetailsPath">Inspect exact version</MudLink>
        @if (node.Kind is "requirement" or "test-case")
        {
            @if (!node.Editable) { <p>Outgoing links locked: @(node.HasNewerVersion ? "a newer owner version exists" : $"owner is {node.Status}").</p> }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ActionsDisabled || !ProductOf(node).IsActive || !node.Editable)"
                OnClick="@(() => BeginAdd(node, false))" aria-label="@($"Add outgoing link from {node.Label}")">Add outgoing link</MudButton>
        }
        @if (!ProductOf(node).IsActive) { <p>Link changes locked: Product retired.</p> }
        @if (node.Kind != "test-case")
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ActionsDisabled || !ProductOf(node).IsActive)"
                OnClick="@(() => BeginAdd(node, true))" aria-label="@($"Add incoming link to {node.Label}")">Add incoming link</MudButton>
        }
        @if (node.VersionId != _view!.Center.VersionId)
        {
            var expanded = _exploration!.Expanded.Contains(node.VersionId);
            <p>@(expanded ? "Neighborhood expanded." : "Neighborhood not expanded; more relationships may exist.")</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => Toggle(node))" aria-expanded="@expanded" aria-label="@($"{(expanded ? "Collapse" : "Expand")} {node.Label}")">@(expanded ? "Collapse" : "Expand") @node.Label</MudButton>
        }
    </div>;
}
