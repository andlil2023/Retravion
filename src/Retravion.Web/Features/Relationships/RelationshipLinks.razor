@page "/products/links"

@if (Kind == "revision")
{
    <RevisionLinks Id="Id" ProductId="@ProductId" OperationId="OperationId" />
}
else
{
    <EntityLinks Kind="@Kind" Id="Id" VersionId="VersionId" />
}
@code {
    [SupplyParameterFromQuery(Name = "kind")] public string? Kind { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? VersionId { get; set; }
    [SupplyParameterFromQuery(Name = "product")] public string? ProductId { get; set; }
    [SupplyParameterFromQuery(Name = "operation")] public Guid? OperationId { get; set; }
}
