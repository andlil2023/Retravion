@page "/requirements/details"
@inject RequirementOperations Operations
@inject ProductOperations Products
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>Requirement · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="Requirement" BackHref="@BackPath" BackText="Requirements" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_pending is not null)
{ <MudButton OnClick="RetrieveOutcome" Disabled="_busy">Retrieve successor outcome before retrying</MudButton> }
@if (_requirement is not null && _product is not null)
{
    <div class="requirement-details">
    <p class="requirement-context" aria-label="Product context">@_product.Id · @_product.Name <span aria-hidden="true">/</span> Requirements</p>
    <MudPaper Class="pa-4" Elevation="0">
        <div class="requirement-heading">
            <div class="requirement-identity">
                <p class="requirement-id">@_requirement.Requirement.Id</p>
                <h2>@_requirement.Requirement.Title</h2>
            </div>
            <div class="requirement-metadata">
                <div class="requirement-badges">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Version @_requirement.Requirement.VersionNumber</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="requirement-status">@(_requirement.Requirement.Status == RequirementStatus.InReview ? "In Review" : _requirement.Requirement.Status.ToString())</MudChip>
                </div>
                <details class="requirement-versions">
                    <summary>Versions</summary>
                    <nav aria-label="Requirement versions">
                        @foreach (var version in _versions ?? [])
                        {
                            <MudLink Href="@($"/requirements/details?id={Id}&version={version.Requirement.VersionId}")" aria-current="@(version.Requirement.VersionId == _requirement.Requirement.VersionId ? "page" : null)">@($"v{version.Requirement.VersionNumber}") · @(version.Requirement.Status == RequirementStatus.InReview ? "In Review" : version.Requirement.Status.ToString())</MudLink>
                        }
                    </nav>
                </details>
            </div>
        </div>
        <p>Type: @_requirement.Requirement.Type</p>
        @if (_requirement.Requirement.AreaId is null) { <p>Area: Unclassified</p> }
        else { <AreaDisplay Product="_product.InternalId" AreaId="_requirement.Requirement.AreaId" /> }
        @if (!_product.IsActive) { <p>Product retired</p> }
        @if (_requirement.Requirement.CreationReason is { } reason) { <p>Successor creation reason: @reason</p> }
        @if (!IsLatest) { <p>This earlier version is read-only because a newer version exists.</p> }
        <section class="requirement-statement" aria-labelledby="requirement-statement-heading">
            <h3 id="requirement-statement-heading">Statement</h3><ProductMarkdownView Markdown="@_requirement.Requirement.Statement" />
            <h3>Rationale</h3><p style="white-space:pre-wrap">@(_requirement.Requirement.Rationale ?? "Not provided")</p>
        </section>
        @if (_provenance is { } origin)
        {
            <h3>Derived from</h3>
            <p>Source Product: @origin.SourceProductId</p>
            <p>Source Requirement: @origin.SourceRequirementId · ID: @origin.SourceManualId</p>
            <p>Source version: @origin.SourceVersionId · v@origin.SourceVersionNumber · @origin.SourceStatus</p>
            @if (_sourceAccessible) { <MudLink Href="@($"/requirements/details?id={origin.SourceRequirementId}&version={origin.SourceVersionId}")">Open source version</MudLink> }
            <p>Title: @origin.SourceTitle · Type: @origin.SourceType</p>
            <h4>Source statement at copy time</h4><ProductMarkdownView Markdown="@origin.SourceStatement" />
            <p style="white-space:pre-wrap">Source rationale: @(origin.SourceRationale ?? "Not provided")</p>
        }
    </MudPaper>
    <div class="requirement-actions mt-4" role="group" aria-label="Requirement actions">
        @if (_product.IsActive && IsLatest && _pending is null && _requirement.Requirement.Status == RequirementStatus.Draft)
        {
            <MudButton Href="@($"/requirements/edit?id={_requirement.Requirement.InternalId}")" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Edit</MudButton>
        }
        <MudButton Href="@($"/products/links?kind=requirement&id={_requirement.Requirement.InternalId}&version={_requirement.Requirement.VersionId}")">Manage links</MudButton>
        <MudButton Href="@($"/requirements/derive?id={_requirement.Requirement.InternalId}&version={_requirement.Requirement.VersionId}")">Copy to another Product</MudButton>
    </div>
    @if (_product.IsActive && IsLatest && _pending is null)
    {
        <section class="requirement-review mt-6" aria-labelledby="requirement-review-heading">
            <MudPaper Class="pa-4" Elevation="0">
                <h3 id="requirement-review-heading">@(_requirement.Requirement.Status == RequirementStatus.Draft ? "Submit for review" : _requirement.Requirement.Status == RequirementStatus.InReview ? "Review decision" : "Change approved Requirement")</h3>
                @if (_requirement.Requirement.Status == RequirementStatus.Approved)
                {
                    <MudTextField @bind-Value="_reason" Label="Change or reopening reason" Required="true" Disabled="_busy" />
                }
                else
                {
                    <MudTextField @bind-Value="_comment" Label="Review comment (optional)" Variant="Variant.Outlined" Lines="2" Class="mt-4" Disabled="_busy" />
                }
            </MudPaper>
            <div class="requirement-actions mt-4">
                @if (_requirement.Requirement.Status == RequirementStatus.Draft)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("InReview"))'>Submit for review</MudButton>
                }
                else if (_requirement.Requirement.Status == RequirementStatus.InReview)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("Approved"))'>Approve</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("Draft"))'>Return to Draft</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CreateSuccessor">Create successor Draft</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Reopen">Reopen to Draft</MudButton>
                }
            </div>
        </section>
    }
    <section class="requirement-history mt-8" aria-labelledby="requirement-history-heading">
        <h3 id="requirement-history-heading">Review history</h3>
        @if (_history is null) { <p role="status">Loading review history…</p> }
        else if (_history.Count == 0) { <p>No review decisions yet.</p> }
        else
        {
            @foreach (var item in _history)
            {
                <details><summary>@(item.Decision == "InReview" ? "In Review" : item.Decision) — @item.OccurredAt.ToString("u") — @((item.Actor as Retravion.Application.AuditTrail.AuditActor.Identified)?.Identifier)</summary>
                    <p>@(item.VersionNumber is { } number ? $"v{number}" : "Legacy decision — version attribution was not recorded")</p>
                    <p>Area: @(item.AfterArea?.Display ?? "Not recorded")</p>
                    <p>ID: @item.Id</p><p>Title: @item.Title</p><p>Type: @item.Type</p>
                    <p style="white-space:pre-wrap">Rationale: @(item.Rationale ?? "Not provided")</p>
                    <p style="white-space:pre-wrap">Comment / reason: @(item.Comment ?? "None")</p>
                    <h4>Statement at decision</h4><ProductMarkdownView Markdown="@item.Statement" />
                </details>
            }
        }
    </section>
    </div>
}
@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? VersionId { get; set; }
    private IReadOnlyList<RequirementSnapshot>? _versions;
    private bool IsLatest => _versions?.LastOrDefault()?.Requirement.VersionId == _requirement?.Requirement.VersionId;
    private RequirementSnapshot? _requirement;
    private RequirementProvenance? _provenance;
    private bool _sourceAccessible;
    private Retravion.Domain.Product.Product? _product;
    private IReadOnlyList<RequirementReview>? _history;
    private string? _error, _comment, _reason;
    private bool _busy;
    private Guid? _pending;
    private Guid _pendingProduct;
    private string BackPath => _product is null ? "/products" : $"/requirements?product={Uri.EscapeDataString(_product.Id)}";
    protected override async Task OnParametersSetAsync() { _comment = null; _reason = null; await Load(); }
    private async Task Load()
    {
        _requirement = null; _product = null; _history = null; _versions = null; _provenance = null; _sourceAccessible = false; _error = null;
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        var result = await Operations.Find(actor, Id, versionId: VersionId);
        if (result.IsFailure) { _error = result.Error; return; }
        if (result.Value.HasNoValue) { _error = "Requirement not found."; return; }
        _requirement = result.Value.Value;
        var versions = await Operations.Versions(actor, Id);
        if (versions.IsFailure) { _error = versions.Error; return; }
        _versions = versions.Value;
        var products = await Products.List(actor);
        if (products.IsFailure) { _error = products.Error; return; }
        _product = products.Value.SingleOrDefault(p => p.InternalId == _requirement.Requirement.ProductInternalId);
        if (_product is null) { _error = "Product not found."; return; }
        var provenance = await Operations.Provenance(actor, Id);
        if (provenance.IsFailure) { _error = provenance.Error; return; }
        if (provenance.Value.HasValue)
        {
            _provenance = provenance.Value.Value;
            var source = await Operations.Find(actor, _provenance.SourceRequirementId, versionId: _provenance.SourceVersionId);
            _sourceAccessible = source.IsSuccess && source.Value.HasValue;
        }
        var history = await Operations.History(actor, Id);
        if (history.IsFailure) _error = history.Error; else _history = history.Value;
    }
    private Task Reopen() => ChangeVersion(false);
    private Task CreateSuccessor() => ChangeVersion(true);
    private async Task ChangeVersion(bool successor)
    {
        if (_busy || _pending is not null || _requirement is null) return;
        _busy = true; _error = null;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            if (successor) { _pending = Guid.NewGuid(); _pendingProduct = _requirement.Requirement.ProductInternalId; }
            var result = successor ? await Operations.CreateSuccessor(actor, _requirement, _reason, operationId: _pending) : await Operations.Reopen(actor, _requirement, _reason);
            if (result.IsFailure)
            {
                _error = result.Error;
                if (!result.Error.Contains("outcome could not be confirmed", StringComparison.Ordinal)) _pending = null;
            }
            else
            {
                _pending = null; _reason = null; VersionId = result.Value.Requirement.VersionId;
                Navigation.NavigateTo($"/requirements/details?id={Id}&version={VersionId}");
                await Load();
            }
        }
        finally { _busy = false; }
    }
    private async Task RetrieveOutcome()
    {
        if (_busy || _pending is null || _product is null) return;
        _busy = true;
        try
        {
            var outcome = await Operations.Outcome((await Authentication.GetAuthenticationStateAsync()).User, _pendingProduct, _pending.Value);
            if (outcome.IsFailure) { _error = outcome.Error; return; }
            _pending = null;
            if (outcome.Value.HasValue) { Id = outcome.Value.Value.InternalId; VersionId = outcome.Value.Value.VersionId; }
            await Load();
        }
        finally { _busy = false; }
    }
    private async Task Review(string decision)
    {
        if (_busy || _pending is not null || _requirement is null) return;
        _busy = true; _error = null;
        try
        {
            var result = await Operations.Review((await Authentication.GetAuthenticationStateAsync()).User, _requirement, decision, _comment);
            if (result.IsFailure) _error = result.Error;
            else { _comment = null; await Load(); }
        }
        finally { _busy = false; }
    }
}
