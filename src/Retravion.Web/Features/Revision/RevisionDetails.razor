@page "/revisions/details"
@using CSharpFunctionalExtensions
@using Retravion.Application.AuditTrail
@inject RevisionOperations Operations
@inject ProductOperations Products
@inject AuthenticationStateProvider Authentication

<PageTitle>Revision · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="Revision" BackHref="@ListPath" BackText="Revisions" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_message is not null) { <MudAlert Severity="Severity.Info" role="status">@_message</MudAlert> }
@if (_row is not null)
{
    <div class="revision-heading"><div><span class="eyebrow">@_product!.Id · @_product.Name</span><h2>@_row.Value.Identifier</h2></div><span class="state">@(_row.Deleted ? "Deleted Draft — retained evidence" : _row.Value.State)</span></div>
    @if (!_product!.IsActive) { <MudAlert Severity="Severity.Info" Dense="true">Product retired: read-only.</MudAlert> }
    <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="ChangeTab" KeepPanelsAlive="false" Elevation="0" Rounded="true" Border="true">
        <MudTabPanel Text="Overview">
            <div class="overview-grid">
                <section>
                    <MudPaper Class="pa-4 revision-card" Elevation="0">
                        <h3>Revision details</h3><p class="description">@(string.IsNullOrWhiteSpace(_row.Value.Description) ? "No description recorded." : _row.Value.Description)</p>
                        <div class="counts"><div><strong>@_row.Value.Selections.Length</strong><span>Selected records</span></div><div><strong>@(_baseline?.Members.Count ?? 0)</strong><span>Total in baseline</span></div></div>
                        @if (_row.Value is ReleasedRevision released)
                        { <p>Released @released.ReleasedAt.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'") by @RevisionPresentation.Actor(released.ReleasedBy). Frozen release evidence is permanently protected.</p> }
                    </MudPaper>
                    <div class="page-actions">
                        @if (CanChange) { <MudButton Href="@($"/revisions/edit?product={Uri.EscapeDataString(ProductId ?? "")}&id={Id}")" Disabled="Locked">Edit details</MudButton> }
                        @if (!_row.Deleted)
                        { <MudButton Href="@RevisionPresentation.WorkspacePath(_product.Id, Id)" Disabled="Locked" Variant="Variant.Filled" Color="Color.Primary">@(_row.Value is ReleasedRevision ? "View baseline" : "Manage links")</MudButton> }
                        @if (CanChange || CanCopy)
                        {
                            <details class="more-actions"><summary>More actions</summary><div class="more-actions-list">
                                @if (CanChange) { <MudButton OnClick="BeginDelete" Disabled="Locked">Delete Draft</MudButton> }
                                @if (CanCopy) { <MudButton Href="@($"/revisions/create?product={Uri.EscapeDataString(ProductId ?? "")}&source={Id}")" Disabled="Locked">Copy to new Draft</MudButton> }
                            </div></details>
                        }
                    </div>
                </section>
                @if (_row.Value is DraftRevision && !_row.Deleted && _baseline is not null)
                {
                    <section>
                        <MudPaper Class="pa-4 revision-card" Elevation="0">
                            <h3>Release readiness</h3>
                            @if (CanRelease) { <p class="readiness">Ready for release review</p><p>All @_baseline.Members.Count baseline records are Approved.</p> }
                            else
                            {
                                <p class="readiness">Release blocked</p>
                                @if (_baseline.Members.Count == 0) { <p>Select at least one exact version to prepare a baseline.</p> }
                                else
                                {
                                    @if (_baseline.Members.Any(m => m.Status != "Approved"))
                                    {
                                    <p>@_baseline.Members.Count(m => m.Status != "Approved") records need approval.</p>
                                    <details><summary>Show blockers</summary><ul aria-label="Release blockers">
                                        @foreach (var blocker in _baseline.Members.Where(m => m.Status != "Approved"))
                                        { <li><MudLink Href="@RevisionPresentation.EndpointPath(blocker.Endpoint)">@RevisionPresentation.Label(blocker)</MudLink> · @blocker.Title · @RevisionPresentation.State(blocker.Status)</li> }
                                    </ul></details>
                                    }
                                    else { <p>All @_baseline.Members.Count baseline records are Approved.</p> }
                                }
                            }
                            @if (!_product.IsActive) { <p>Release also requires an active Product.</p> }
                        </MudPaper>
                        @if (CanChange)
                        { <div class="page-actions"><MudButton OnClick="ConfirmRelease" Disabled="@(Locked || !CanRelease)" Variant="Variant.Filled" Color="Color.Primary">Review release</MudButton><MudButton OnClick="RefreshBaseline" Disabled="Locked" Size="Size.Small">Refresh baseline</MudButton></div> }
                    </section>
                }
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Contents">
            <MudPaper Class="pa-4 revision-card" Elevation="0">
                <h3>Baseline contents</h3><p class="muted">@(_row.Value is ReleasedRevision ? "Frozen release evidence, not current-link traversal." : "Complete outgoing baseline: selected roots and records included through their outgoing links. Incoming neighbors are not included.")</p>
                <RevisionContents Members="@(_baseline?.Members ?? [])" />
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="History">
            <MudPaper Class="pa-4 revision-card" Elevation="0">
                <h3>Revision history</h3>
                @foreach (var item in _history.OrderByDescending(h => h.OccurredAt))
                {
                    <article class="history-entry"><div class="history-summary"><strong>@RevisionPresentation.Action(item.Action)</strong><time datetime="@item.OccurredAt.ToUniversalTime().ToString("O")">@item.OccurredAt.ToUniversalTime().ToString("dd MMM yyyy, HH:mm 'UTC'")</time></div>
                        <p class="muted">@(item.Actor is AuditActor.Identified actor ? RevisionPresentation.Actor(actor.Identifier) : "Unknown actor")</p>
                        <Retravion.Web.Features.AuditTrail.AuditEventDetails Event="@(new AuditInformation(item.Actor, item.OccurredAt, item.Action, new AuditTarget.Identified(Id.ToString()), AuditActionOutcome.Success, revisionChange: item.Change))" />
                    </article>
                }
                @if (_history.Count == 0) { <p>No retained history.</p> }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
    @if (_pendingAction is not null && !Locked)
    {
        <MudPaper Class="pa-4 revision-card mt-4" Elevation="0">
            @if (_pendingAction == "delete") { <h3>Confirm Draft deletion</h3><p>Confirm deletion of Draft @_row.Value.Identifier. Referenced records and prior evidence will remain.</p> }
            else
            { <h3>Review release</h3><p>Confirm release of @_row.Value.Identifier with this complete exact baseline. Every listed version will be permanently protected. The server will revalidate before committing.</p><RevisionContents Members="@(_baseline?.Members ?? [])" Searchable="false" /> }
        </MudPaper>
        <div class="page-actions"><MudButton OnClick="Confirm" Disabled="Locked" Variant="Variant.Filled" Color="Color.Primary">@(_pendingAction == "release" ? "Confirm release" : "Confirm deletion")</MudButton><MudButton OnClick="Cancel" Disabled="Locked">Cancel change</MudButton></div>
    }
}
@if (_uncertain)
{
    <p>No automatic retry. Retrieve the outcome before making another change.</p>
    <MudButton OnClick="RetrieveOutcome" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">Retrieve outcome</MudButton>
    <MudLink Href="@($"/revisions/details?product={Uri.EscapeDataString(ProductId ?? "")}&id={Id}&operation={_operation}")">Outcome retrieval link</MudLink>
}
@code {
    [SupplyParameterFromQuery(Name = "product")] public string? ProductId { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "operation")] public Guid? OperationId { get; set; }
    private Retravion.Domain.Product.Product? _product;
    private RevisionSnapshot? _row;
    private RevisionBaseline? _baseline;
    private IReadOnlyList<RevisionHistory> _history = [];
    private string? _error, _message, _pendingAction;
    private Guid _operation;
    private int _tab, _load;
    private bool _busy, _uncertain;
    private bool CanChange => _product?.IsActive == true && _row is { Deleted: false, Value: DraftRevision };
    private bool CanCopy => _product?.IsActive == true && _row is { Deleted: false, Value: ReleasedRevision };
    private bool CanRelease => CanChange && _baseline is { Members.Count: > 0 } && _baseline.Members.All(m => m.Status == "Approved");
    private bool Locked => _busy || _uncertain;
    private string ListPath => $"/revisions?product={Uri.EscapeDataString(ProductId ?? "")}";
    private void ChangeTab(int tab) { if (!_busy) _tab = tab; }
    private void BeginDelete() { if (CanChange && !Locked) _pendingAction = "delete"; }
    private void Cancel() => _pendingAction = null;
    protected override async Task OnParametersSetAsync()
    {
        var load = ++_load; _error = _message = null; _row = null; _baseline = null; _history = []; _uncertain = false; _tab = 0; Cancel();
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        var product = await Products.Retrieve(actor, ProductId);
        if (load != _load) return;
        if (product.IsFailure) { _error = product.Error; return; }
        _product = product.Value; _operation = OperationId ?? Guid.Empty;
        await Load(OperationId);
    }
    private async Task Load(Guid? operation = null)
    {
        var load = _load; var product = _product!; var id = Id;
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        var found = await Operations.Retrieve(actor, product.InternalId, id, operation);
        if (load != _load) return;
        if (found.IsFailure) { _error = found.Error; _row = null; _baseline = null; _history = []; return; }
        var row = found.Value.Record;
        if (row is null) { _error = "No revision exists for this immutable identity."; _row = null; return; }
        var history = await Operations.History(actor, product.InternalId, id);
        if (load != _load) return;
        if (history.IsFailure) { _error = history.Error; _row = null; return; }
        RevisionBaseline? baseline = null;
        if (!row.Deleted)
        {
            var result = await Operations.Baseline(actor, product.InternalId, id);
            if (load != _load) return;
            if (result.IsFailure) { _error = result.Error; _row = null; return; }
            baseline = result.Value; row = baseline.Revision;
        }
        _row = row; _history = history.Value; _baseline = baseline;
        if (operation is not null) _message = found.Value.Operation is null ? "The attempted operation did not commit. Current state retrieved." : "The attempted operation committed. Current state retrieved.";
    }
    private void ConfirmRelease() { if (!Locked && CanChange && CanRelease) _pendingAction = "release"; }
    private async Task RefreshBaseline()
    {
        if (Locked) return;
        _busy = true; _error = _message = null; Cancel();
        try { await Load(); } finally { _busy = false; }
    }
    private async Task Confirm()
    {
        if (Locked || !CanChange || _pendingAction is null) return;
        var load = _load; var expected = _row!; var action = _pendingAction; var baselineToken = _baseline?.Token ?? "";
        _busy = true; _error = _message = null; _operation = Guid.NewGuid();
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = action == "delete" ? await Operations.Delete(actor, _operation, expected, true)
                : await Operations.Release(actor, _operation, expected, baselineToken, true);
            if (load != _load) return;
            if (result.IsFailure) { _error = result.Error; _uncertain = result.Error.Contains("could not be confirmed", StringComparison.Ordinal); if (!_uncertain) Cancel(); }
            else { Cancel(); await Load(); }
        }
        finally { _busy = false; }
    }
    private async Task RetrieveOutcome()
    {
        if (_busy || !_uncertain) return;
        _busy = true; _error = null;
        try { await Load(_operation); if (_error is null) { _uncertain = false; Cancel(); } }
        finally { _busy = false; }
    }
}
