@page "/test-cases/details"
@using Retravion.Application.Requirement
@using Retravion.Application.AuditTrail
@inject TestCaseOperations Operations
@inject Retravion.Web.Features.Requirement.RequirementOperations Requirements
@inject ProductOperations Products
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>Test Case details · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="Test Case details" BackHref="@BackPath" BackText="Test Cases" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_uncertain)
{
    <p>No automatic retry. Retrieve the current Test Case before deciding on another change.</p>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="RetrieveOutcome">Retrieve current Test Case</MudButton>
}
@if (_case is not null && _product is not null)
{
    var value = _case.TestCase;
    <p>@_product.Id – @_product.Name</p>
    <h2>@value.Id – @value.Content.Title</h2>
    @if (value.AreaId is null) { <p>Area: Unclassified</p> }
    else { <AreaDisplay Product="_product.InternalId" AreaId="value.AreaId" /> }
    <p>@($"v{value.VersionNumber}") · @Status(value.Status)</p>
    @if (!_product.IsActive) { <p>This Test Case is read-only because its Product is retired.</p> }
    @if (!IsLatest) { <p>This earlier version is read-only because a newer version exists.</p> }
    @if (_versions.Count > 1)
    {
        <nav aria-label="Other Test Case versions" class="test-case-versions">
            <span>Other versions:</span>
            @foreach (var version in _versions.Where(row => row.TestCase.VersionId != value.VersionId))
            { <MudLink Href="@($"/test-cases/details?id={Id}&version={version.TestCase.VersionId}")">@($"v{version.TestCase.VersionNumber}") · @Status(version.TestCase.Status)</MudLink> }
        </nav>
    }
    <MudPaper Class="product-card pa-4" Elevation="0">
        @if (value.CreationReason is { } reason) { <p style="white-space:pre-wrap">Successor creation reason: @reason</p> }
        <section aria-label="Description" class="test-case-section"><h3 class="section-label">Description</h3><ProductMarkdownView Markdown="@value.Content.Description" /></section>
        <section aria-label="Preconditions" class="test-case-section"><h3 class="section-label">Preconditions</h3><ProductMarkdownView Markdown="@value.Content.Preconditions" /></section>
        <section aria-label="Steps" class="test-case-section">
            <h3 class="section-label">Steps</h3>
            <div class="test-case-steps">
                <MudTable Items="@(value.Content.Steps.Select((step, index) => (Step: step, Number: index + 1)))" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" aria-label="Test Case steps">
                    <HeaderContent><MudTh Class="step-number">Step</MudTh><MudTh>Action</MudTh><MudTh>Expected result</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Step" Class="step-number">@context.Number</MudTd>
                        <MudTd DataLabel="Action"><div class="step-markdown"><ProductMarkdownView Markdown="@context.Step.Action" /></div></MudTd>
                        <MudTd DataLabel="Expected result"><div class="step-markdown"><ProductMarkdownView Markdown="@context.Step.ExpectedResult" /></div></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>No steps yet.</MudText></NoRecordsContent>
                </MudTable>
            </div>
        </section>
    </MudPaper>
    <div class="product-actions" role="group" aria-label="Test Case actions">
        @if (Editable)
        {
            <MudButton Href="@($"/test-cases/edit?id={value.InternalId}&version={value.VersionId}")" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Edit Draft</MudButton>
        }
        <MudButton Href="@($"/products/links?kind=test-case&id={value.InternalId}&version={value.VersionId}")" Disabled="_busy">Manage links</MudButton>
    </div>
    <MudPaper Class="product-card pa-4 mt-4" Elevation="0">
        <section aria-label="Requirement links" class="test-case-requirements">
            <h3 class="section-label">Requirement links</h3>
            <p>These links point to specific Requirement versions. New versions do not update the links automatically.</p>
            <MudTable Items="value.Links" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" aria-label="Linked Requirements">
                <HeaderContent><MudTh>Requirement ID</MudTh><MudTh>Title</MudTh><MudTh>Version</MudTh></HeaderContent>
                <RowTemplate>
                    @{ var target = Target(context); }
                    <MudTd DataLabel="Requirement ID"><MudLink Href="@RequirementPath(context)">@(target?.Requirement.Id ?? "Requirement unavailable")</MudLink></MudTd>
                    <MudTd DataLabel="Title">@(target?.Requirement.Title ?? "Exact Requirement version unavailable")</MudTd>
                    <MudTd DataLabel="Version">
                        @(target is null ? "Unavailable" : $"v{target.Requirement.VersionNumber}")
                        @if (NewerAvailable(context)) { <span class="requirement-version-note">Newer version available; check suitability before changing the link.</span> }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No Requirement links yet.</MudText></NoRecordsContent>
            </MudTable>
        </section>
    </MudPaper>
    @if (_product.IsActive && IsLatest)
    {
        <div class="product-actions">
            @if (value.Status == "Draft")
            {
                <MudTextField @bind-Value="_comment" Label="Review comment (optional)" Disabled="_busy" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("InReview"))'>Submit for review</MudButton>
            }
            else if (value.Status == "InReview")
            {
                <MudTextField @bind-Value="_comment" Label="Review comment (optional)" Disabled="_busy" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("Approved"))'>Approve</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("Draft"))'>Return to Draft</MudButton>
            }
            else
            {
                <MudTextField @bind-Value="_reason" Label="Change reason" Required="true" Disabled="_busy" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CreateSuccessor">Create successor Draft</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Reopen">Reopen to Draft</MudButton>
            }
        </div>
    }
    @if (_product.IsActive && IsLatest)
    {
        @if (value.Status == "Approved")
        { <p>Reopen requires a reason and no Released-revision protection. For protected corrections, create a successor Draft.</p> }
        else
        { <p>Approval is not release.</p> }
    }
    <MudPaper Class="product-card pa-4 mt-4" Elevation="0">
        <h3>History</h3>
        @if (_history.Count == 0) { <p>No history recorded.</p> }
        @foreach (var item in _history)
        {
            var change = item.Change;
            var snapshot = change.After;
            <details>
                <summary>@(change.Decision ?? item.Action) · @($"v{change.VersionNumber}") · @item.OccurredAt.ToString("u") · @((item.Actor as AuditActor.Identified)?.Identifier)</summary>
                <p>@snapshot.Id · @Status(snapshot.Status)</p>
                <p style="white-space:pre-wrap">Comment: @(change.Comment ?? "None")</p>
                @if (change.Reason is not null) { <p style="white-space:pre-wrap">Change reason: @change.Reason</p> }
                @if (change.SourceVersionId is { } source)
                { <MudLink Href="@($"/test-cases/details?id={change.InternalId}&version={source}")">Exact source Test Case version</MudLink> }
                <h4>Title at event</h4><p style="white-space:pre-wrap">@snapshot.Title</p>
                <h4>Description at event</h4><ProductMarkdownView Markdown="@snapshot.Description" />
                <h4>Preconditions at event</h4><ProductMarkdownView Markdown="@snapshot.Preconditions" />
                @for (var i = 0; i < snapshot.Steps.Length; i++)
                {
                    <h4>Step @(i + 1) at event</h4>
                    <ProductMarkdownView Markdown="@snapshot.Steps[i].Action" />
                    <ProductMarkdownView Markdown="@snapshot.Steps[i].ExpectedResult" />
                }
                @if (change.Before is { } previous && change.Decision is "LinkAdded" or "LinkRemoved" or "LinkRetargeted")
                { <h4>Old exact Requirement endpoints</h4>@HistoryLinks(previous.Links) }
                <h4>Exact Requirement endpoints at event</h4>@HistoryLinks(snapshot.Links)
            </details>
        }
    </MudPaper>
}
@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? VersionId { get; set; }
    private TestCaseSnapshot? _case;
    private Retravion.Domain.Product.Product? _product;
    private IReadOnlyList<TestCaseSnapshot> _versions = [];
    private IReadOnlyList<TestCaseHistory> _history = [];
    private readonly List<RequirementSnapshot> _targets = [];
    private string? _error, _comment, _reason;
    private bool _busy, _uncertain;
    private bool IsLatest => _versions.LastOrDefault()?.TestCase.VersionId == _case?.TestCase.VersionId;
    private bool Editable => _product?.IsActive == true && IsLatest && _case?.TestCase.Status == "Draft";
    private string BackPath => _product is null ? "/products" : $"/test-cases?product={Uri.EscapeDataString(_product.Id)}";
    private static string Status(string value) => value == "InReview" ? "In Review" : value;
    private static string RequirementPath(TestCaseRequirementLink endpoint) => $"/requirements/details?id={endpoint.RequirementInternalId}&version={endpoint.RequirementVersionId}";
    private static string TargetLabel(RequirementSnapshot target) => $"{target.Requirement.Id} v{target.Requirement.VersionNumber} · {target.Requirement.Title} · {target.Requirement.Status}";
    private RequirementSnapshot? Target(TestCaseRequirementLink endpoint) => _targets.FirstOrDefault(target => target.Requirement.InternalId == endpoint.RequirementInternalId && target.Requirement.VersionId == endpoint.RequirementVersionId);
    private string EndpointLabel(TestCaseRequirementLink endpoint) => Target(endpoint) is { } row
        ? TargetLabel(row) : "Exact Requirement version unavailable";
    private bool NewerAvailable(TestCaseRequirementLink endpoint) => _targets.FirstOrDefault(row => row.Requirement.VersionId == endpoint.RequirementVersionId) is { } target &&
        _targets.Any(row => row.Requirement.InternalId == endpoint.RequirementInternalId && row.Requirement.VersionNumber > target.Requirement.VersionNumber);
    private RenderFragment HistoryLinks(IReadOnlyList<TestCaseRequirementLink>? links) => @<ul>
        @foreach (var endpoint in links ?? [])
        { <li><MudLink Href="@RequirementPath(endpoint)">@EndpointLabel(endpoint)</MudLink></li> }
    </ul>;

    protected override async Task OnParametersSetAsync() { _comment = null; _reason = null; await Load(); }
    private async Task Load()
    {
        _case = null; _product = null; _error = null; _versions = []; _history = []; _targets.Clear();
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        var found = await Operations.Find(actor, Id, VersionId);
        if (found.IsFailure) { _error = found.Error; return; }
        if (found.Value.HasNoValue) { _error = "Test Case version not found."; return; }
        var products = await Products.List(actor);
        if (products.IsFailure) { _error = products.Error; return; }
        _product = products.Value.SingleOrDefault(product => product.InternalId == found.Value.Value.TestCase.ProductInternalId);
        if (_product is null) { _error = "Product not found."; return; }
        _case = found.Value.Value;
        var versions = await Operations.Versions(actor, Id);
        if (versions.IsFailure) { _error = versions.Error; return; }
        _versions = versions.Value;
        var history = await Operations.History(actor, Id);
        if (history.IsFailure) { _error = history.Error; return; }
        _history = history.Value;
        // Explicitly load all exact target versions: selection never substitutes the latest.
        var requirements = await Requirements.List(actor, _product.InternalId);
        if (requirements.IsFailure) { _error = requirements.Error; return; }
        foreach (var requirement in requirements.Value)
        {
            var targets = await Requirements.Versions(actor, requirement.Requirement.InternalId);
            if (targets.IsFailure) { _error = targets.Error; return; }
            _targets.AddRange(targets.Value);
        }
        _uncertain = _successorOperation is not null;
    }
    private async Task RetrieveOutcome()
    {
        if (_busy || !_uncertain) return;
        _busy = true;
        try
        {
            if (_successorOperation is { } operation)
            {
                var outcome = await Operations.Outcome((await Authentication.GetAuthenticationStateAsync()).User, _pendingProduct, operation);
                if (outcome.IsFailure) { _error = outcome.Error; return; }
                if (outcome.Value.HasValue) { Id = outcome.Value.Value.InternalId; VersionId = outcome.Value.Value.VersionId; }
                _successorOperation = null;
            }
            await Load();
        }
        finally { _busy = false; }
    }
    private Task Review(string decision) => Change((actor, expected) => Operations.Review(actor, expected, decision, _comment));
    private Guid? _successorOperation;
    private Guid _pendingProduct;
    private Task CreateSuccessor() => Change((actor, expected) =>
    {
        _successorOperation = Guid.NewGuid(); _pendingProduct = expected.TestCase.ProductInternalId;
        return Operations.CreateSuccessor(actor, expected, _reason, operationId: _successorOperation);
    });
    private Task Reopen() => Change((actor, expected) => Operations.Reopen(actor, expected, _reason));
    private async Task Change(Func<System.Security.Claims.ClaimsPrincipal, TestCaseSnapshot, Task<CSharpFunctionalExtensions.Result<TestCaseSnapshot>>> operation)
    {
        if (_busy || _uncertain || _case is null) return;
        _busy = true; _error = null;
        try
        {
            var result = await operation((await Authentication.GetAuthenticationStateAsync()).User, _case);
            if (result.IsFailure)
            {
                _error = result.Error;
                _uncertain = result.Error.Contains("could not be confirmed", StringComparison.Ordinal);
                if (!_uncertain) _successorOperation = null;
            }
            else
            {
                _successorOperation = null; _comment = null; _reason = null; VersionId = result.Value.TestCase.VersionId;
                Navigation.NavigateTo($"/test-cases/details?id={Id}&version={VersionId}");
                await Load();
            }
        }
        finally { _busy = false; }
    }
}
