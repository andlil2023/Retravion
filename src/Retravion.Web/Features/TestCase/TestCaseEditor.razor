@page "/test-cases/create"
@page "/test-cases/edit"
@inject TestCaseOperations Operations
@inject ProductOperations Products
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>@(_editing ? "Edit" : "Create") Test Case · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="@(_editing ? "Edit Test Case" : "Create Test Case")" BackHref="@BackPath" BackText="Test Cases" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_pending is not null)
{ <MudButton OnClick="RetrieveOutcome" Disabled="_busy">Retrieve operation outcome before retrying</MudButton> }
@if (_message is not null) { <p role="status">@_message</p> }
@if (_ready)
{
    <MudPaper Class="product-card" Elevation="0">
        <form id="test-case-form" @onsubmit="Save" @onsubmit:preventDefault aria-label="Save Test Case">
            <div class="pa-4">
                <p>@_product!.Id – @_product.Name · @(_existing?.TestCase.Id ?? "ID assigned on creation") · @($"v{_existing?.TestCase.VersionNumber ?? 1}") Draft</p>
                <p>Drafts may be incomplete. Manage exact Requirement links and submit for review from details.</p>
                <AreaSelect Product="_product.InternalId" @bind-Value="_area" RetainedArea="_existing?.TestCase.AreaId" Disabled="_busy" />
                <MudTextField @bind-Value="_title" Label="Title" Immediate="true" Disabled="_busy" />
            </div>
            <DescriptionEditor @key="_formKey" FieldOnly="true" InputId="test-case-description" InitialDescription="@_description" DescriptionChanged="@(value => _description = value)" Label="Description" Busy="_busy" />
            <DescriptionEditor @key="_preconditionsKey" FieldOnly="true" InputId="test-case-preconditions" InitialDescription="@_preconditions" DescriptionChanged="@(value => _preconditions = value)" Label="Preconditions" Busy="_busy" />
            <div class="pa-4"><h2>Steps</h2></div>
            <div class="test-case-steps px-4">
                <p>Action and expected result support Markdown. Formatting is shown on details after saving.</p>
                <MudTable Items="_steps" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" aria-label="Edit Test Case steps">
                    <HeaderContent>
                        <MudTh Class="step-number">Step</MudTh><MudTh>Action</MudTh><MudTh>Expected result</MudTh><MudTh Class="step-controls">Step actions</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="step">
                        @{ var index = _steps.IndexOf(step); }
                        <MudTd DataLabel="Step" Class="step-number">@(index + 1)</MudTd>
                        <MudTd DataLabel="Action">
                            <MudTextField @key="step.Key" T="string" InputId="@($"action-{step.Key}")" @bind-Value="step.Action" Immediate="true"
                                          Label="@($"Step {index + 1} action")" Lines="1" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                        </MudTd>
                        <MudTd DataLabel="Expected result">
                            <MudTextField @key="step.Key" T="string" InputId="@($"result-{step.Key}")" @bind-Value="step.ExpectedResult" Immediate="true"
                                          Label="@($"Step {index + 1} expected result")" Lines="1" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                        </MudTd>
                        <MudTd DataLabel="Step actions" Class="step-controls">
                            <div class="step-action-buttons">
                                <MudIconButton Size="Size.Small" ButtonType="ButtonType.Button" Icon="@Icons.Material.Outlined.Add" OnClick="@(() => Insert(step))" Disabled="_busy" aria-label="@($"Insert step above step {index + 1}")" title="Insert step above" />
                                <MudIconButton Size="Size.Small" ButtonType="ButtonType.Button" Icon="@Icons.Material.Outlined.ArrowUpward" OnClick="@(() => Move(step, -1))" Disabled="@(_busy || index == 0)" aria-label="@($"Move step {index + 1} up")" title="Move step up" />
                                <MudIconButton Size="Size.Small" ButtonType="ButtonType.Button" Icon="@Icons.Material.Outlined.ArrowDownward" OnClick="@(() => Move(step, 1))" Disabled="@(_busy || index == _steps.Count - 1)" aria-label="@($"Move step {index + 1} down")" title="Move step down" />
                                <MudIconButton Size="Size.Small" ButtonType="ButtonType.Button" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => Remove(step))" Disabled="_busy" aria-label="@($"Remove step {index + 1}")" title="Remove step" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>No steps yet.</MudText></NoRecordsContent>
                </MudTable>
            </div>
            <div class="pa-4"><MudButton ButtonType="ButtonType.Button" OnClick="Add" Disabled="_busy">Add step</MudButton></div>
        </form>
    </MudPaper>
    <div class="product-actions">
        <MudButton ButtonType="ButtonType.Submit" form="test-case-form" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _pending is not null)">Save Draft</MudButton>
        <MudButton Href="@BackPath" Disabled="_busy">Cancel</MudButton>
    </div>
}
@code {
    [SupplyParameterFromQuery(Name = "product")] public string? ProductId { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? VersionId { get; set; }
    private TestCaseSnapshot? _existing;
    private Guid? _area, _pending;
    private Guid _pendingProduct;
    private string? _message;
    private Retravion.Domain.Product.Product? _product;
    private string _title = "", _description = "", _preconditions = "";
    private readonly List<StepDraft> _steps = [];
    private Guid _formKey, _preconditionsKey;
    private string? _error;
    private bool _busy, _ready, _editing;
    private string BackPath => _existing is not null ? $"/test-cases/details?id={_existing.TestCase.InternalId}&version={_existing.TestCase.VersionId}"
        : $"/test-cases?product={Uri.EscapeDataString(ProductId ?? "")}";

    protected override async Task OnParametersSetAsync()
    {
        _ready = false; _error = null; _existing = null; _product = null; _steps.Clear();
        _title = _description = _preconditions = ""; _area = null;
        _formKey = Guid.NewGuid(); _preconditionsKey = Guid.NewGuid();
        _editing = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        if (_editing)
        {
            var found = await Operations.Find(actor, Id, VersionId);
            if (found.IsFailure) { _error = found.Error; return; }
            if (found.Value.HasNoValue) { _error = "Test Case version not found."; return; }
            _existing = found.Value.Value; _area = _existing.TestCase.AreaId;
            if (_existing.TestCase.Status != "Draft") { _error = "Only Draft Test Cases can be edited."; return; }
            var versions = await Operations.Versions(actor, Id);
            if (versions.IsFailure) { _error = versions.Error; return; }
            if (versions.Value.LastOrDefault()?.TestCase.VersionId != _existing.TestCase.VersionId)
            { _error = "This earlier version is read-only because a newer version exists."; return; }
            var products = await Products.List(actor);
            if (products.IsFailure) { _error = products.Error; return; }
            _product = products.Value.SingleOrDefault(product => product.InternalId == _existing.TestCase.ProductInternalId);
            var content = _existing.TestCase.Content;
            _title = content.Title; _description = content.Description; _preconditions = content.Preconditions;
            _steps.AddRange(content.Steps.Select(step => new StepDraft(step.Action, step.ExpectedResult)));
        }
        else
        {
            var found = await Products.Retrieve(actor, ProductId);
            if (found.IsFailure) { _error = found.Error; return; }
            _product = found.Value;
        }
        if (_product?.IsActive != true) { _error = "The responsible Product is retired or no longer exists."; return; }
        _ready = true;
    }

    private void Add() { if (!_busy) _steps.Add(new("", "")); }
    private void Insert(StepDraft step)
    {
        if (_busy) return;
        var index = _steps.IndexOf(step);
        if (index >= 0) _steps.Insert(index, new("", ""));
    }
    private void Remove(StepDraft step) { if (!_busy) _steps.Remove(step); }
    private void Move(StepDraft step, int direction)
    {
        if (_busy) return;
        var oldIndex = _steps.IndexOf(step);
        var newIndex = oldIndex + direction;
        if (oldIndex < 0 || newIndex < 0 || newIndex >= _steps.Count) return;
        _steps.RemoveAt(oldIndex); _steps.Insert(newIndex, step);
    }
    private async Task RetrieveOutcome()
    {
        if (_busy || _pending is null || _product is null) return;
        _busy = true;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var outcome = await Operations.Outcome(actor, _pendingProduct, _pending.Value);
            if (outcome.IsFailure) { _error = outcome.Error; return; }
            if (outcome.Value.HasValue)
            {
                var change = outcome.Value.Value;
                _pending = null;
                Navigation.NavigateTo($"/test-cases/details?id={change.InternalId}&version={change.VersionId}");
            }
            else
            {
                _pending = null; _error = null;
                _message = "No change committed for this operation. Review the current record before a user-directed retry.";
                if (_existing is not null)
                {
                    var current = await Operations.Find(actor, _existing.TestCase.InternalId);
                    if (current.IsFailure || current.Value.HasNoValue || current.Value.Value.Revision != _existing.Revision)
                    { _ready = false; _error = "The Test Case changed or could not be retrieved. Reload the editor and review current values before retrying."; }
                }
            }
        }
        finally { _busy = false; }
    }
    private async Task Save()
    {
        if (_busy || !_ready || _pending is not null) return;
        _busy = true; _error = null;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var steps = _steps.Select(step => new TestCaseStep(step.Action, step.ExpectedResult)).ToArray();
            _pending = Guid.NewGuid(); _pendingProduct = _product!.InternalId;
            var result = _existing is null
                ? await Operations.Create(actor, _product!.InternalId, _title, _description, _preconditions, steps, areaId: _area, operationId: _pending)
                : await Operations.Edit(actor, _existing, _title, _description, _preconditions, steps, changeArea: true, areaId: _area, operationId: _pending);
            if (result.IsFailure)
            {
                _error = result.Error;
                if (!result.Error.Contains("outcome could not be confirmed", StringComparison.Ordinal)) _pending = null;
            }
            else { _pending = null; Navigation.NavigateTo($"/test-cases/details?id={result.Value.TestCase.InternalId}&version={result.Value.TestCase.VersionId}"); }
        }
        finally { _busy = false; }
    }
    private sealed class StepDraft(string action, string expectedResult)
    {
        public Guid Key { get; } = Guid.NewGuid();
        public string Action { get; set; } = action;
        public string ExpectedResult { get; set; } = expectedResult;
    }
}
