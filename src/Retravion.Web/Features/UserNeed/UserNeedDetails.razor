@page "/user-needs/details"
@inject UserNeedOperations Operations
@inject ProductOperations Products
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>User Need · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="User Need" BackHref="@BackPath" BackText="User Needs" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_need is not null && _product is not null)
{
    <div class="need-details">
    <p class="need-context" aria-label="Product context">@_product.Id · @_product.Name <span aria-hidden="true">/</span> User Needs</p>
    <MudPaper Class="pa-4 need-card" Elevation="0">
        <div class="need-heading">
            <div class="need-identity">
                <p class="need-id">@_need.Need.Id</p>
                <h2>@_need.Need.Title</h2>
            </div>
            <div class="need-metadata">
                <div class="need-badges">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Version @_need.Need.VersionNumber</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="need-status">@(_need.Need.Status == UserNeedStatus.InReview ? "In Review" : _need.Need.Status.ToString())</MudChip>
                </div>
                <details class="need-versions">
                    <summary>Versions</summary>
                    <nav aria-label="User Need versions">
                        @foreach (var version in _versions ?? [])
                        {
                            <MudLink Href="@($"/user-needs/details?id={Id}&version={version.Need.VersionId}")" aria-current="@(version.Need.VersionId == _need.Need.VersionId ? "page" : null)">@($"v{version.Need.VersionNumber}") · @(version.Need.Status == UserNeedStatus.InReview ? "In Review" : version.Need.Status.ToString())</MudLink>
                        }
                    </nav>
                </details>
            </div>
        </div>
        @if (!_product.IsActive) { <p class="mt-4">Product retired</p> }
        @if (_need.Need.CreationReason is { } reason) { <p class="mt-4">Successor creation reason: @reason</p> }
        @if (!IsLatest) { <p class="mt-4">This earlier version is read-only because a newer version exists.</p> }
        <section class="need-statement" aria-labelledby="need-statement-heading">
            <h3 id="need-statement-heading">Statement</h3><ProductMarkdownView Markdown="@_need.Need.Statement" />
        </section>
        @if (_provenance is { } origin)
        {
            <h3>Derived from</h3>
            <p>Source Product: @origin.SourceProductId</p>
            <p>Source User Need: @origin.SourceNeedId · ID: @origin.SourceManualId</p>
            <p>Source version: @origin.SourceVersionId · v@origin.SourceVersionNumber · @origin.SourceStatus</p>
            @if (_sourceAccessible) { <MudLink Href="@($"/user-needs/details?id={origin.SourceNeedId}&version={origin.SourceVersionId}")">Open source version</MudLink> }
            <p>Title: @origin.SourceTitle</p>
            <h4>Source statement at copy time</h4><ProductMarkdownView Markdown="@origin.SourceStatement" />
        }
    </MudPaper>
    <div class="need-actions mt-4" role="group" aria-label="User Need actions">
        @if (_product.IsActive && IsLatest && _need.Need.Status == UserNeedStatus.Draft)
        {
            <MudButton Href="@($"/user-needs/edit?id={_need.Need.InternalId}")" Variant="Variant.Filled" Color="Color.Primary">Edit</MudButton>
        }
        <MudButton Href="@($"/products/links?kind=user-need&id={_need.Need.InternalId}&version={_need.Need.VersionId}")">Manage links</MudButton>
        <MudButton Href="@($"/user-needs/derive?id={_need.Need.InternalId}&version={_need.Need.VersionId}")">Copy to another Product</MudButton>
    </div>
    @if (_product.IsActive && IsLatest)
    {
        <section class="need-review mt-6" aria-labelledby="need-review-heading">
            <MudPaper Class="pa-4 need-card" Elevation="0">
                <h3 id="need-review-heading">@(_need.Need.Status == UserNeedStatus.Draft ? "Submit for review" : _need.Need.Status == UserNeedStatus.InReview ? "Review decision" : "Change approved User Need")</h3>
                @if (_need.Need.Status == UserNeedStatus.Approved)
                {
                    <MudTextField @bind-Value="_reason" Label="Change or reopening reason" Required="true" />
                }
                else
                {
                    <MudTextField @bind-Value="_comment" Label="Review comment (optional)" Variant="Variant.Outlined" Lines="2" Class="mt-4" />
                }
            </MudPaper>
            <div class="need-actions mt-4">
                @if (_need.Need.Status == UserNeedStatus.Draft)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("InReview"))'>Submit for review</MudButton>
                }
                else if (_need.Need.Status == UserNeedStatus.InReview)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick='@(() => Review("Approved"))'>Approve</MudButton>
                    <MudButton Disabled="_busy" OnClick='@(() => Review("Draft"))'>Return to Draft</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CreateSuccessor">Create successor Draft</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Reopen">Reopen to Draft</MudButton>
                }
            </div>
        </section>
    }
    <section class="need-history mt-8" aria-labelledby="need-history-heading">
        <h3 id="need-history-heading">Review history</h3>
        @if (_history is null) { <p role="status">Loading review history…</p> }
        else if (_history.Count == 0) { <p>No review decisions yet.</p> }
        else
        {
            @foreach (var item in _history)
            {
                <details><summary>@item.Decision — @item.OccurredAt.ToString("u") — @((item.Actor as Retravion.Application.AuditTrail.AuditActor.Identified)?.Identifier)</summary>
                    <p>@(item.VersionNumber is { } number ? $"v{number} · {item.ManualId}" : "Legacy decision — version attribution was not recorded")</p>
                    <p>Title: @item.Title</p><p>Comment / reason: @(item.Comment ?? "None")</p>
                    <h4>Statement at decision</h4><ProductMarkdownView Markdown="@item.Statement" />
                </details>
            }
        }
    </section>
    </div>
}
@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public Guid? VersionId { get; set; }
    private IReadOnlyList<UserNeedSnapshot>? _versions;
    private bool IsLatest => _versions?.LastOrDefault()?.Need.VersionId == _need?.Need.VersionId;
    private UserNeedSnapshot? _need;
    private UserNeedProvenance? _provenance;
    private bool _sourceAccessible;
    private Retravion.Domain.Product.Product? _product;
    private IReadOnlyList<UserNeedReview>? _history;
    private string? _error, _comment, _reason;
    private bool _busy;
    private string BackPath => _product is null ? "/products" : $"/user-needs?product={Uri.EscapeDataString(_product.Id)}";
    protected override async Task OnParametersSetAsync() => await Load();
    private async Task Load()
    {
        _need = null; _product = null; _history = null; _versions = null; _provenance = null; _sourceAccessible = false; _error = null;
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        var result = await Operations.Find(actor, Id, versionId: VersionId);
        if (result.IsFailure) { _error = result.Error; return; }
        if (result.Value.HasNoValue) { _error = "User Need not found."; return; }
        _need = result.Value.Value;
        var versions = await Operations.Versions(actor, Id);
        if (versions.IsFailure) { _error = versions.Error; return; }
        _versions = versions.Value;
        var products = await Products.List(actor);
        if (products.IsFailure) { _error = products.Error; return; }
        _product = products.Value.SingleOrDefault(p => p.InternalId == _need.Need.ProductInternalId);
        if (_product is null) { _error = "Product not found."; return; }
        var provenance = await Operations.Provenance(actor, Id);
        if (provenance.IsFailure) { _error = provenance.Error; return; }
        if (provenance.Value.HasValue)
        {
            _provenance = provenance.Value.Value;
            var source = await Operations.Find(actor, _provenance.SourceNeedId, versionId: _provenance.SourceVersionId);
            _sourceAccessible = source.IsSuccess && source.Value.HasValue;
        }
        var history = await Operations.History(actor, Id);
        if (history.IsFailure) _error = history.Error; else _history = history.Value;
    }
    private Task Reopen() => ChangeVersion(false);
    private Task CreateSuccessor() => ChangeVersion(true);
    private async Task ChangeVersion(bool successor)
    {
        if (_busy || _need is null) return;
        _busy = true; _error = null;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = successor ? await Operations.CreateSuccessor(actor, _need, _reason) : await Operations.Reopen(actor, _need, _reason);
            if (result.IsFailure) _error = result.Error;
            else
            {
                _reason = null; VersionId = result.Value.Need.VersionId;
                Navigation.NavigateTo($"/user-needs/details?id={Id}&version={VersionId}");
                await Load();
            }
        }
        finally { _busy = false; }
    }
    private async Task Review(string decision)
    {
        if (_busy || _need is null) return;
        _busy = true; _error = null;
        try
        {
            var result = await Operations.Review((await Authentication.GetAuthenticationStateAsync()).User, _need, decision, _comment);
            if (result.IsFailure) _error = result.Error;
            else { _comment = null; await Load(); }
        }
        finally { _busy = false; }
    }
}
