@page "/user-needs/create"
@page "/user-needs/edit"
@inject UserNeedOperations Operations
@inject ProductOperations Products
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>@(_existing is null ? "Create" : "Edit") User Need · Retravion</PageTitle>
<SectionContent SectionName="product-page-header"><PageHeader Title="@(_editing ? "Edit User Need" : "Create User Need")" BackHref="@BackPath" BackText="User Needs" /></SectionContent>
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
@if (_ready)
{
    <DescriptionEditor InitialDescription="@_statement" Busy="_busy" OnSave="Save" FormId="user-need-form" SubmitText="Save" CancelHref="@BackPath" Label="Statement">
        <ChildContent>
            <MudTextField @bind-Value="_id" Label="User Need ID" Required="true" Immediate="true" Disabled="@(_existing?.Need.HasBeenApproved == true)" />
            <MudTextField @bind-Value="_title" Label="Title" Required="true" Immediate="true" />
        </ChildContent>
    </DescriptionEditor>
}
@code {
    [SupplyParameterFromQuery(Name = "product")] public string? ProductId { get; set; }
    private Guid _productInternalId;
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    private UserNeedSnapshot? _existing;
    private string _id = "", _title = "", _statement = "";
    private string? _error;
    private bool _busy, _ready, _editing;
    private string BackPath => _existing is not null ? $"/user-needs/details?id={_existing.Need.InternalId}" : $"/user-needs?product={Uri.EscapeDataString(ProductId ?? "")}";
    protected override async Task OnParametersSetAsync()
    {
        _ready = false; _error = null; _existing = null;
        _editing = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);
        var actor = (await Authentication.GetAuthenticationStateAsync()).User;
        if (_editing)
        {
            var result = await Operations.Find(actor, Id);
            if (result.IsFailure) { _error = result.Error; return; }
            if (result.Value.HasNoValue) { _error = "User Need not found."; return; }
            _existing = result.Value.Value;
            _productInternalId = _existing.Need.ProductInternalId;
            if (_existing.Need.Status != UserNeedStatus.Draft) { _error = "Only Draft User Needs can be edited."; return; }
            _id = _existing.Need.Id; _title = _existing.Need.Title; _statement = _existing.Need.Statement;
        }
        Retravion.Domain.Product.Product? product;
        if (_editing)
        {
            var products = await Products.List(actor);
            if (products.IsFailure) { _error = products.Error; return; }
            product = products.Value.SingleOrDefault(p => p.InternalId == _productInternalId);
        }
        else
        {
            var found = await Products.Retrieve(actor, ProductId);
            if (found.IsFailure) { _error = found.Error; return; }
            product = found.Value;
        }
        if (product is null || !product.IsActive) { _error = "The responsible Product is retired or no longer exists."; return; }
        _productInternalId = product.InternalId;
        _ready = true;
    }
    private async Task Save(string statement)
    {
        if (_busy || !_ready) return;
        _busy = true; _error = null;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = _existing is null ? await Operations.Create(actor, _productInternalId, _id, _title, statement)
                : await Operations.Edit(actor, _existing, _id, _title, statement);
            if (result.IsFailure) _error = result.Error;
            else Navigation.NavigateTo($"/user-needs/details?id={result.Value.Need.InternalId}");
        }
        finally { _busy = false; }
    }
}
